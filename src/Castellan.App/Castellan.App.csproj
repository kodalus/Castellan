<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Android to urzadzenie, na ktorym dziala przechwytywanie powiadomien bankowych
         — tam aplikacja sie zaczela. Windows jest dla osob, ktore nie uzywaja telefonu
         wcale: tam powiadomien nie ma i caly budzet wpisuje sie recznie. -->
    <TargetFrameworks>net10.0-android36.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>Castellan.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>

    <ApplicationTitle>Castellan</ApplicationTitle>
    <ApplicationId>dev.castellan.app</ApplicationId>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <NeutralLanguage>pl-PL</NeutralLanguage>
  </PropertyGroup>

  <!-- Android 10 (API 29) minimum, Android 16 (API 36) target -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <SupportedOSPlatformVersion>29.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!-- Windows 10 October 2018 Update — najnizsza wersja, ktora unosi WinUI 3. -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>

    <!-- Bez pakowania w MSIX: zwykly exe, ktory da sie skopiowac i uruchomic. MSIX
         wymagalby podpisu, a niepodpisany nie zainstaluje sie bez trybu dewelopera. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0F2B5B" />
    <!-- Tło splashu = Ground z palety. Granat zostaje na ikonie w launcherze (tam
         jest znakiem rozpoznawczym), ale przy starcie mignięcie granatem tuż przed
         prawie czarnym ekranem widać jako szew. -->
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0F1216" BaseSize="180,180" />
    <MauiImage Include="Resources\Images\*" />
    <!-- Ikony zakładek rysowane są na siatce 24×24 — bez tego skalowałyby się
         od domyślnej podstawy i na pasku wyszłyby rozmyte. -->
    <MauiImage Update="Resources\Images\tab_*.svg" BaseSize="24,24" />
    <MauiFont Include="Resources\Fonts\*" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Castellan.Domain\Castellan.Domain.csproj" />
    <ProjectReference Include="..\Castellan.Application\Castellan.Application.csproj" />
    <ProjectReference Include="..\Castellan.Infrastructure\Castellan.Infrastructure.csproj" />
  </ItemGroup>

</Project>
