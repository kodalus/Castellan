<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Castellan.App.ViewModels"
             x:Class="Castellan.App.Views.ContributeFundPage"
             x:DataType="vm:ContributeFundViewModel"
             Title="Wpłata do funduszu">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Potwierdź" Command="{Binding SaveCommand}" />
    </ContentPage.ToolbarItems>

    <VerticalStackLayout Padding="16" Spacing="16">

        <!-- Fund name card -->
        <Border Padding="14,12" StrokeShape="RoundRectangle 8">
            <VerticalStackLayout Spacing="4">
                <Label Text="Fundusz" FontSize="12" TextColor="Gray" />
                <Label Text="{Binding FundName}"
                       FontSize="18" FontAttributes="Bold" />
            </VerticalStackLayout>
        </Border>

        <!-- Error banner -->
        <Border IsVisible="{Binding HasError}"
                BackgroundColor="#FFEBEE" Padding="12,8"
                StrokeShape="RoundRectangle 6" Stroke="Transparent">
            <Label Text="{Binding ErrorMessage}" TextColor="#C62828" FontSize="13" />
        </Border>

        <!-- Amount -->
        <VerticalStackLayout Spacing="4">
            <Label Text="Kwota wpłaty (zł)" FontSize="13" TextColor="Gray" />
            <Entry Text="{Binding AmountText}"
                   Keyboard="Numeric"
                   Placeholder="np. 200"
                   FontSize="20" />
        </VerticalStackLayout>

        <ActivityIndicator IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center" />

    </VerticalStackLayout>

</ContentPage>
