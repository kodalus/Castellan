<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Castellan.App.ViewModels"
             x:Class="Castellan.App.Views.ContributeFundPage"
             x:DataType="vm:ContributeFundViewModel"
             Title="Wpłata do funduszu">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Potwierdź" Command="{Binding SaveCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource FormBody}">

            <Border Style="{StaticResource ErrorBanner}" IsVisible="{Binding HasError}">
                <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
            </Border>

            <VerticalStackLayout Spacing="2">
                <Label Text="Fundusz" Style="{StaticResource SectionHeader}" />
                <Label Text="{Binding FundName}" Style="{StaticResource Title}" />
            </VerticalStackLayout>

            <!-- Kwota to jedyne pole na tym ekranie, więc wolno jej być duża:
                 nie ma z czym konkurować, a wpisuje się ją w biegu. -->
            <VerticalStackLayout Style="{StaticResource Field}">
                <Label Text="Kwota wpłaty (zł)" Style="{StaticResource FieldLabel}" />
                <Entry Text="{Binding AmountText}" Keyboard="Numeric" Placeholder="np. 200"
                       FontSize="{StaticResource SizeTitle}"
                       ReturnCommand="{Binding SaveCommand}" />
            </VerticalStackLayout>

            <!-- Przełącznik, a nie od razu dwa pola: ekran ma jedno duże pole na kwotę
                 i wpisuje się go w biegu. Pola „skąd" i „dokąd" pojawiają się dopiero
                 wtedy, gdy naprawdę są potrzebne. -->
            <VerticalStackLayout Style="{StaticResource Field}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                        <Label Text="Zapisz też przelew między kontami" Style="{StaticResource FieldLabel}" />
                        <Label Style="{StaticResource FieldHint}"
                               Text="Zostaw wyłączone, jeśli ten przelew trafi do aplikacji z powiadomienia — inaczej ta sama kwota obciąży kopertę „Rezerwy” dwa razy." />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" IsToggled="{Binding RecordTransfer, Mode=TwoWay}"
                            VerticalOptions="Center" />
                </Grid>
            </VerticalStackLayout>

            <VerticalStackLayout Style="{StaticResource Field}" IsVisible="{Binding RecordTransfer}">
                <Label Text="Z konta" Style="{StaticResource FieldLabel}" />
                <Picker ItemsSource="{Binding Accounts}" SelectedItem="{Binding FromAccount, Mode=TwoWay}"
                        ItemDisplayBinding="{Binding Name}" />
            </VerticalStackLayout>

            <VerticalStackLayout Style="{StaticResource Field}" IsVisible="{Binding RecordTransfer}">
                <Label Text="Na konto" Style="{StaticResource FieldLabel}" />
                <Picker ItemsSource="{Binding Accounts}" SelectedItem="{Binding ToAccount, Mode=TwoWay}"
                        ItemDisplayBinding="{Binding Name}" />
                <Label Style="{StaticResource FieldHint}"
                       Text="Odkładasz do portfela? Załóż konto typu „Gotówka” i wskaż je tutaj — wtedy pieniądze nie znikają z Majątku." />
            </VerticalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
