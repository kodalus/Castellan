<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Castellan.App.ViewModels"
             xmlns:usecases="clr-namespace:Castellan.Application.UseCases;assembly=Castellan.Application"
             x:Class="Castellan.App.Views.IncomePage"
             x:DataType="vm:IncomeViewModel"
             Title="Przychody">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Planuj" Command="{Binding PlanIncomeCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="0">

        <Label Grid.Row="0" Text="{Binding MonthDisplay}" Style="{StaticResource SectionHeader}"
               HorizontalTextAlignment="Center" Margin="16,14,16,8" />

        <!-- „Otrzymano” jest większe od „zaplanowano”, bo to fakt, a nie zamiar. -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="12,0,12,8">
            <VerticalStackLayout Spacing="8">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0" Spacing="3">
                        <Label Text="Otrzymano" Style="{StaticResource SectionHeader}" />
                        <Label Text="{Binding ActualTotalDisplay}" Style="{StaticResource SubHero}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                        <Label Text="Zaplanowano" Style="{StaticResource SectionHeader}" />
                        <Label Text="{Binding PlannedTotalDisplay}" Style="{StaticResource SubHero}"
                               TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>
                </Grid>
                <Label Text="{Binding DifferenceDisplay}" Style="{StaticResource PositiveCaption}">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding IsShort}" Value="True">
                            <Setter Property="TextColor" Value="{StaticResource Negative}" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </VerticalStackLayout>
        </Border>

        <CollectionView Grid.Row="2" ItemsSource="{Binding Items}" Margin="16,0">
            <CollectionView.EmptyView>
                <Label Text="Brak planu przychodów na ten miesiąc. Tapnij „Planuj”, żeby wpisać spodziewane kwoty."
                       Style="{StaticResource EmptyState}" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="usecases:IncomeOverview">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="5" Padding="0,10">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Label Grid.Column="0" Text="{Binding CategoryName}"
                                   Style="{StaticResource RowTitle}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Style="{StaticResource Secondary}" VerticalOptions="Center">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding ActualDisplay}" TextColor="{StaticResource TextPrimary}" />
                                        <Span Text=" / " />
                                        <Span Text="{Binding PlannedDisplay}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </Grid>
                        <ProgressBar Grid.Row="1" Progress="{Binding ReceivedRatio}" HeightRequest="4"
                                     ProgressColor="{StaticResource Positive}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
