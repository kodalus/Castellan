<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Castellan.App.ViewModels"
             x:Class="Castellan.App.Views.DebtPlanPage"
             x:DataType="vm:DebtPlanViewModel"
             Title="Plan spłaty">

    <ScrollView>
        <VerticalStackLayout Padding="12,12,12,32" Spacing="10">

            <VerticalStackLayout IsVisible="{Binding IsDebtFree}" Spacing="6" Margin="0,48">
                <Label Text="Brak zobowiązań" Style="{StaticResource Title}"
                       HorizontalTextAlignment="Center" />
                <Label Text="Nic nie jesteś nikomu winna." Style="{StaticResource Secondary}"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <VerticalStackLayout IsVisible="{Binding HasDebts}" Spacing="10">

                <!-- Kwota postawiona wprost — cały sens tego ekranu polega na tym,
                     żeby na nią spojrzeć, więc nie jest niczym złagodzona. -->
                <Border Style="{StaticResource Card}" Margin="0">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Zostało do spłaty" Style="{StaticResource SectionHeader}" />
                        <Label Text="{Binding TotalDebtDisplay}" Style="{StaticResource Hero}"
                               TextColor="{StaticResource Negative}" />
                    </VerticalStackLayout>
                </Border>

                <!-- ...a zaraz pod nią wyjście, żeby ekran nie kończył się na problemie. -->
                <Border Style="{StaticResource Card}" Margin="0"
                        BackgroundColor="{StaticResource PositiveWash}"
                        Stroke="{StaticResource PositiveDim}">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="{Binding FreedomDisplay}" Style="{StaticResource SubHero}"
                               TextColor="{StaticResource Positive}" />
                        <Label Text="{Binding FreedomDateDisplay}" Style="{StaticResource Secondary}"
                               TextColor="{StaticResource Positive}" />
                        <Label Text="{Binding ComparisonDisplay}" Style="{StaticResource InfoCaption}"
                               IsVisible="{Binding HasComparison}" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Style="{StaticResource Field}" Margin="4,10,4,0">
                    <Label Text="Spłacam miesięcznie (zł)" Style="{StaticResource FieldLabel}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Entry Grid.Column="0" Text="{Binding MonthlyText}" Keyboard="Numeric" />
                        <Button Grid.Column="1" Text="Rata" Command="{Binding ResetToMinimumCommand}"
                                Style="{StaticResource GhostButton}" />
                    </Grid>
                    <Label Text="{Binding MinimumHintDisplay}" Style="{StaticResource FieldHint}" />
                    <Label Text="Podnieś kwotę i zobacz, o ile skróci się droga."
                           Style="{StaticResource FieldHint}" />
                </VerticalStackLayout>

                <Border Style="{StaticResource WarningBanner}" Margin="0,4,0,0"
                        IsVisible="{Binding IsBelowMinimum}">
                    <Label Style="{StaticResource WarningText}"
                           Text="To mniej niż suma rat — przy tej kwocie nie obsłużysz wszystkich zobowiązań." />
                </Border>

                <VerticalStackLayout Spacing="3" Margin="4,14,4,0">
                    <Label Text="Kolejność znikania" Style="{StaticResource SectionHeader}" />
                    <Label Text="Najpierw najmniejszy dług — gdy zniknie, jego rata przyspiesza kolejny."
                           Style="{StaticResource Caption}" />
                </VerticalStackLayout>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Steps}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:PayoffStepVm">
                            <Border Style="{StaticResource CardRow}" Margin="0,3">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Name}" Style="{StaticResource RowTitle}" />
                                        <Label Text="{Binding BalanceDisplay}" Style="{StaticResource Caption}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding ClearedDisplay}"
                                           Style="{StaticResource PositiveCaption}" VerticalOptions="Center"
                                           HorizontalTextAlignment="End" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label Text="Wyliczenie nie uwzględnia odsetek — przy oprocentowanych kredytach rzeczywisty czas będzie nieco dłuższy."
                       Style="{StaticResource Caption}" Margin="4,10,4,0" />

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
