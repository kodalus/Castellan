<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Castellan.App.ViewModels"
             x:Class="Castellan.App.Views.DebtPlanPage"
             x:DataType="vm:DebtPlanViewModel"
             Title="Plan spłaty">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <!-- Debt-free state: no numbers to confront -->
            <VerticalStackLayout IsVisible="{Binding IsDebtFree}" Spacing="8" Margin="0,40">
                <Label Text="Brak zobowiązań" FontSize="20" FontAttributes="Bold"
                       HorizontalOptions="Center" />
                <Label Text="Nic nie jesteś nikomu winna."
                       FontSize="13" TextColor="Gray" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <VerticalStackLayout IsVisible="{Binding HasDebts}" Spacing="16">

                <!-- The number, stated plainly -->
                <Border Padding="16,14" StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Zostało do spłaty" FontSize="12" TextColor="Gray" />
                        <Label Text="{Binding TotalDebtDisplay}"
                               FontSize="30" FontAttributes="Bold" TextColor="#C62828" />
                    </VerticalStackLayout>
                </Border>

                <!-- The way out -->
                <Border Padding="16,14" StrokeShape="RoundRectangle 12"
                        BackgroundColor="{AppThemeBinding Light=#E8F5E9, Dark=#1B5E2022}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding FreedomDisplay}"
                               FontSize="26" FontAttributes="Bold" TextColor="#2E7D32" />
                        <Label Text="{Binding FreedomDateDisplay}"
                               FontSize="14" TextColor="#2E7D32" />
                        <Label Text="{Binding ComparisonDisplay}"
                               FontSize="12" TextColor="#1565C0"
                               IsVisible="{Binding HasComparison}" />
                    </VerticalStackLayout>
                </Border>

                <!-- What if I paid more? -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="Spłacam miesięcznie (zł)" FontSize="13" TextColor="Gray" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Entry Grid.Column="0" Text="{Binding MonthlyText}" Keyboard="Numeric" />
                        <Button Grid.Column="1" Text="Rata"
                                Command="{Binding ResetToMinimumCommand}"
                                FontSize="12" Padding="12,6" CornerRadius="6" />
                    </Grid>
                    <Label Text="{Binding MinimumHintDisplay}" FontSize="11" TextColor="Gray" />
                    <Label Text="Podnieś kwotę i zobacz, o ile skróci się droga."
                           FontSize="11" TextColor="Gray" />
                </VerticalStackLayout>

                <Border IsVisible="{Binding IsBelowMinimum}"
                        BackgroundColor="#FFF9C4" Padding="12,8"
                        StrokeShape="RoundRectangle 6" Stroke="Transparent">
                    <Label Text="To mniej niż suma rat — przy tej kwocie nie obsłużysz wszystkich zobowiązań."
                           FontSize="12" TextColor="#5D4037" />
                </Border>

                <!-- Snowball cascade -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="Kolejność znikania" FontSize="12" FontAttributes="Bold" TextColor="Gray" />
                    <Label Text="Najpierw najmniejszy dług — gdy zniknie, jego rata przyspiesza kolejny."
                           FontSize="11" TextColor="Gray" />
                </VerticalStackLayout>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Steps}" Spacing="0">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:PayoffStepVm">
                            <Border Margin="0,3" Padding="14,10" StrokeShape="RoundRectangle 8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="{Binding Name}" FontSize="14"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding BalanceDisplay}" FontSize="11" TextColor="Gray" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding ClearedDisplay}"
                                           FontSize="12" FontAttributes="Bold" TextColor="#2E7D32"
                                           HorizontalOptions="End" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label Text="Wyliczenie nie uwzględnia odsetek — dla oprocentowanych kredytów rzeczywisty czas będzie nieco dłuższy."
                       FontSize="11" TextColor="Gray" Margin="0,8,0,0" />

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
