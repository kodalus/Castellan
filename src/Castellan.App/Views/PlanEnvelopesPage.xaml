<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Castellan.App.ViewModels"
             x:Class="Castellan.App.Views.PlanEnvelopesPage"
             x:DataType="vm:PlanEnvelopesViewModel"
             Title="Plan miesiąca">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Zapisz" Command="{Binding SaveCommand}" />
        <ToolbarItem Text="Anuluj" Command="{Binding CancelCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="16,12,16,32" Spacing="10">

            <Label Text="{Binding MonthDisplay}" Style="{StaticResource SectionHeader}"
                   HorizontalTextAlignment="Center" Margin="0,0,0,6" />

            <!-- ===== Przychody ===== -->
            <Label Text="Przychody" Style="{StaticResource SectionHeader}" />
            <Label Text="Ile spodziewasz się dostać z każdego źródła w tym miesiącu."
                   Style="{StaticResource FieldHint}" />

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Incomes}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:EnvelopeInputRow">
                        <Grid ColumnDefinitions="*,Auto" Padding="0,6" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="{Binding CategoryName}"
                                   Style="{StaticResource RowTitle}" VerticalOptions="Center" />
                            <Entry Grid.Column="1" Text="{Binding PlannedAmountText, Mode=TwoWay}"
                                   Keyboard="Numeric" WidthRequest="110"
                                   HorizontalTextAlignment="End" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- Podpowiedzi są przyciskami, bo jedno tapnięcie przepisuje liczbę
                 w pole niżej — stąd wyciszony wygląd zamiast koloru akcji głównej. -->
            <Button Text="{Binding PlannedIncomeDisplay}" Command="{Binding ApplyPlannedIncomeCommand}"
                    IsVisible="{Binding HasPlannedIncome}"
                    Style="{StaticResource GhostButton}" HorizontalOptions="Fill" />

            <BoxView Style="{StaticResource Divider}" Margin="0,8" />

            <!-- ===== Podział środków ===== -->
            <Label Text="Podział środków" Style="{StaticResource SectionHeader}" />

            <VerticalStackLayout Style="{StaticResource Field}">
                <Label Text="Środki do dyspozycji (zł)" Style="{StaticResource FieldLabel}" />
                <Entry Text="{Binding AvailableFundsText}" Keyboard="Numeric" />
            </VerticalStackLayout>

            <Label Text="{Binding RemainingToAllocateDisplay}" Style="{StaticResource PositiveValue}"
                   HorizontalTextAlignment="Start">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding IsOverAllocated}" Value="True">
                        <Setter Property="TextColor" Value="{StaticResource Negative}" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>

            <Button Text="{Binding IncomeHintDisplay}" Command="{Binding ApplyIncomeHintCommand}"
                    IsVisible="{Binding HasIncomeHint}"
                    Style="{StaticResource GhostButton}" HorizontalOptions="Fill" />

            <!-- Przy wypłacie pod koniec miesiąca to ta kwota finansuje ten plan. -->
            <Button Text="{Binding PreviousIncomeHintDisplay}" Command="{Binding ApplyPreviousIncomeHintCommand}"
                    IsVisible="{Binding HasPreviousIncomeHint}"
                    Style="{StaticResource GhostButton}" HorizontalOptions="Fill" />

            <!-- Pomiar, nie suma z okresu: sam uwzględnia wydatki zrobione po wypłacie. -->
            <Button Text="{Binding BalanceHintDisplay}" Command="{Binding ApplyBalanceHintCommand}"
                    IsVisible="{Binding HasBalanceHint}"
                    Style="{StaticResource GhostButton}" HorizontalOptions="Fill" />

            <!-- Bez tego zdania ekran po prostu milczy i wygląda, jakby podpowiedzi
                 nigdy nie było. -->
            <Label Style="{StaticResource FieldHint}" IsVisible="{Binding HasNoIncomeHints}"
                   Text="Brak zapisanych wpływów w tym i poprzednim miesiącu, więc nie ma czego podpowiedzieć — wpisz środki ręcznie. Podpowiedź pojawi się sama, gdy wypłata wpłynie." />

            <Button Text="{Binding ReserveHintDisplay}" Command="{Binding ApplyReserveHintCommand}"
                    IsVisible="{Binding HasReserveHint}"
                    Style="{StaticResource GhostButton}" HorizontalOptions="Fill" />

            <BoxView Style="{StaticResource Divider}" Margin="0,8" />

            <!-- ===== Koperty ===== -->
            <Label Text="Koperty" Style="{StaticResource SectionHeader}" />

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Envelopes}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:EnvelopeInputRow">
                        <Grid ColumnDefinitions="*,Auto" Padding="0,6" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="{Binding CategoryName}"
                                   Style="{StaticResource RowTitle}" VerticalOptions="Center" />
                            <Entry Grid.Column="1" Text="{Binding PlannedAmountText, Mode=TwoWay}"
                                   Keyboard="Numeric" WidthRequest="110"
                                   HorizontalTextAlignment="End" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
