<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Castellan.App.ViewModels"
             x:Class="Castellan.App.Views.PlanEnvelopesPage"
             x:DataType="vm:PlanEnvelopesViewModel"
             Title="Plan miesiąca">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Zapisz" Command="{Binding SaveCommand}" />
        <ToolbarItem Text="Anuluj" Command="{Binding CancelCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label Text="{Binding MonthDisplay}" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" />

            <!-- ── Przychody ─────────────────────────────────────────── -->
            <Label Text="PRZYCHODY" FontSize="12" FontAttributes="Bold" TextColor="Gray" Margin="0,4,0,0" />
            <Label Text="Ile spodziewasz się dostać z każdego źródła w tym miesiącu."
                   FontSize="11" TextColor="Gray" />

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Incomes}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:EnvelopeInputRow">
                        <Grid ColumnDefinitions="*,Auto" Padding="4,8" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="{Binding CategoryName}" FontSize="14" VerticalOptions="Center" />
                            <Entry Grid.Column="1" Text="{Binding PlannedAmountText, Mode=TwoWay}"
                                   Keyboard="Numeric" WidthRequest="100" HorizontalOptions="End" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Button Text="{Binding PlannedIncomeDisplay}"
                    Command="{Binding ApplyPlannedIncomeCommand}"
                    IsVisible="{Binding HasPlannedIncome}"
                    FontSize="12" Padding="12,8" CornerRadius="6"
                    BackgroundColor="#E8F5E9" TextColor="#2E7D32"
                    HorizontalOptions="Fill" />

            <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E0E0E0, Dark=#444}" Margin="0,4" />

            <!-- ── Podział środków ───────────────────────────────────── -->
            <Label Text="PODZIAŁ ŚRODKÓW" FontSize="12" FontAttributes="Bold" TextColor="Gray" />

            <VerticalStackLayout Spacing="4">
                <Label Text="Środki do dyspozycji (zł)" FontSize="13" TextColor="Gray" />
                <Entry Text="{Binding AvailableFundsText}" Keyboard="Numeric" />
            </VerticalStackLayout>

            <Label Text="{Binding RemainingToAllocateDisplay}"
                   FontSize="14" FontAttributes="Bold" TextColor="#2E7D32">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding IsOverAllocated}" Value="True">
                        <Setter Property="TextColor" Value="#C62828" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>

            <Button Text="{Binding IncomeHintDisplay}"
                    Command="{Binding ApplyIncomeHintCommand}"
                    IsVisible="{Binding HasIncomeHint}"
                    FontSize="12" Padding="12,8" CornerRadius="6"
                    BackgroundColor="#E8F5E9" TextColor="#2E7D32"
                    HorizontalOptions="Fill" />

            <Button Text="{Binding ReserveHintDisplay}"
                    Command="{Binding ApplyReserveHintCommand}"
                    IsVisible="{Binding HasReserveHint}"
                    FontSize="12" Padding="12,8" CornerRadius="6"
                    BackgroundColor="#E3F2FD" TextColor="#1565C0"
                    HorizontalOptions="Fill" />

            <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E0E0E0, Dark=#444}" Margin="0,4" />

            <!-- ── Koperty wydatkowe ─────────────────────────────────── -->
            <Label Text="KOPERTY" FontSize="12" FontAttributes="Bold" TextColor="Gray" />

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Envelopes}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:EnvelopeInputRow">
                        <Grid ColumnDefinitions="*,Auto" Padding="4,8" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="{Binding CategoryName}" FontSize="14" VerticalOptions="Center" />
                            <Entry Grid.Column="1" Text="{Binding PlannedAmountText, Mode=TwoWay}"
                                   Keyboard="Numeric" WidthRequest="100" HorizontalOptions="End" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
