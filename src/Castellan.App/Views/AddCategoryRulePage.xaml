<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Castellan.App.ViewModels"
             x:Class="Castellan.App.Views.AddCategoryRulePage"
             x:DataType="vm:AddCategoryRuleViewModel"
             Title="Nowa reguła">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Zapisz" Command="{Binding SaveCommand}" />
        <ToolbarItem Text="Anuluj" Command="{Binding CancelCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource FormBody}">

            <VerticalStackLayout Style="{StaticResource Field}">
                <Label Text="Wzorzec (fragment nazwy sprzedawcy)" Style="{StaticResource FieldLabel}" />
                <Entry Text="{Binding Pattern}" Placeholder="np. McDonald, ORLEN, Biedronka"
                       ClearButtonVisibility="WhileEditing" />
                <Label Text="Transakcja dostanie tę kategorię, gdy nazwa sprzedawcy zawiera ten tekst — wielkość liter nie ma znaczenia."
                       Style="{StaticResource FieldHint}" />
            </VerticalStackLayout>

            <VerticalStackLayout Style="{StaticResource Field}">
                <Label Text="Kategoria" Style="{StaticResource FieldLabel}" />
                <Picker ItemsSource="{Binding Categories}" SelectedIndex="{Binding CategoryIndex}"
                        ItemDisplayBinding="{Binding Name}" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
