<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Castellan.App.ViewModels"
             x:Class="Castellan.App.Views.EditDebtPage"
             x:DataType="vm:EditDebtViewModel"
             Title="Edytuj zobowiązanie">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Zapisz" Command="{Binding SaveCommand}" />
        <ToolbarItem Text="Anuluj" Command="{Binding CancelCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource FormBody}">

            <Border Style="{StaticResource ErrorBanner}" IsVisible="{Binding HasError}">
                <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
            </Border>

            <VerticalStackLayout Style="{StaticResource Field}">
                <Label Text="Nazwa" Style="{StaticResource FieldLabel}" />
                <Entry Text="{Binding Name}" />
            </VerticalStackLayout>

            <VerticalStackLayout Style="{StaticResource Field}">
                <Label Text="Rodzaj" Style="{StaticResource FieldLabel}" />
                <Picker ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind}"
                        ItemDisplayBinding="{Binding Display}" />
            </VerticalStackLayout>

            <VerticalStackLayout Style="{StaticResource Field}">
                <Label Text="Aktualne saldo (zł)" Style="{StaticResource FieldLabel}" />
                <Entry Text="{Binding BalanceText}" Keyboard="Numeric" />
                <Label Text="Popraw, gdy bank pokazuje inną kwotę — odsetki potrafią rozjechać saldo względem sumy zapłaconych rat."
                       Style="{StaticResource FieldHint}" />
            </VerticalStackLayout>

            <VerticalStackLayout Style="{StaticResource Field}">
                <Label Text="Kwota początkowa (zł)" Style="{StaticResource FieldLabel}" />
                <Entry Text="{Binding InitialAmountText}" Keyboard="Numeric" />
                <Label Text="Punkt odniesienia dla paska postępu." Style="{StaticResource FieldHint}" />
            </VerticalStackLayout>

            <VerticalStackLayout Style="{StaticResource Field}">
                <Label Text="Rata miesięczna (zł)" Style="{StaticResource FieldLabel}" />
                <Entry Text="{Binding InstallmentText}" Keyboard="Numeric" />
            </VerticalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
