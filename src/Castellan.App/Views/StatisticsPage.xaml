<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Castellan.App.ViewModels"
             x:Class="Castellan.App.Views.StatisticsPage"
             x:DataType="vm:StatisticsViewModel"
             Title="Statystyki">

    <ScrollView>
        <VerticalStackLayout Padding="12,12,12,24" Spacing="8" IsVisible="{Binding HasData}">

            <!-- Okres jest kontekstem dla wszystkiego poniżej, więc stoi na samej górze.
                 Strzałki przesuwają wybrany miesiąc, przycisk po prawej przełącza między
                 jednym miesiącem a sześcioma. -->
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,2">
                <Button Grid.Column="0" Text="‹" Style="{StaticResource StepperButton}"
                        Command="{Binding PreviousMonthCommand}" />
                <Label Grid.Column="1" Text="{Binding PeriodDisplay}"
                       Style="{StaticResource SectionHeader}"
                       HorizontalTextAlignment="Center" VerticalOptions="Center" />
                <Button Grid.Column="2" Text="›" Style="{StaticResource StepperButton}"
                        Command="{Binding NextMonthCommand}" />
            </Grid>

            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" Margin="0,0,0,6">
                <Button Text="Jeden miesiąc" Command="{Binding ToggleScopeCommand}"
                        Style="{StaticResource RowAction}" Padding="12,5"
                        IsVisible="{Binding IsRange}" />
                <Button Text="6 miesięcy" Command="{Binding ToggleScopeCommand}"
                        Style="{StaticResource RowAction}" Padding="12,5"
                        IsVisible="{Binding IsSingleMonth}" />
            </HorizontalStackLayout>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Border Grid.Column="0" Style="{StaticResource StatTile}">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Wydatki" Style="{StaticResource Caption}" />
                        <Label Text="{Binding TotalExpenseDisplay}" Style="{StaticResource NegativeValue}"
                               HorizontalTextAlignment="Start" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource StatTile}">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Przychody" Style="{StaticResource Caption}" />
                        <Label Text="{Binding TotalIncomeDisplay}" Style="{StaticResource PositiveValue}"
                               HorizontalTextAlignment="Start" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource StatTile}">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Netto" Style="{StaticResource Caption}" />
                        <Label Text="{Binding TotalNetDisplay}" Style="{StaticResource RowValue}"
                               HorizontalTextAlignment="Start">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding NetIsPositive}" Value="True">
                                    <Setter Property="TextColor" Value="{StaticResource Positive}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding NetIsPositive}" Value="False">
                                    <Setter Property="TextColor" Value="{StaticResource Negative}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Odłożone nie jest wydatkiem, ale jest prawdziwym ubytkiem z miesiąca,
                 więc stoi osobno, a nie znika. Netto odejmuje je dalej — inaczej ekran
                 pokazywałby nadwyżkę w miesiącu, w którym konto zjechało w dół. -->
            <Label Text="{Binding SavedDisplay}" Style="{StaticResource Caption}"
                   IsVisible="{Binding HasSaved}" Margin="4,2,4,0" />

            <Label Text="Wydatki — 6 miesięcy (stuknij słupek, by wybrać miesiąc)" Style="{StaticResource SectionHeader}"
                   Margin="4,14,4,0" />
            <Border Style="{StaticResource Card}" Margin="0">
                <HorizontalStackLayout Spacing="6" HorizontalOptions="Center"
                                       BindableLayout.ItemsSource="{Binding ExpenseBars}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:MonthBar">
                            <VerticalStackLayout WidthRequest="44" Spacing="5">
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectCommand}"
                                                          CommandParameter="{Binding SelectParameter}" />
                                </VerticalStackLayout.GestureRecognizers>
                                <Grid HeightRequest="120">
                                    <!-- Dwa segmenty: odłożone na górze, wydane pod spodem.
                                         Jedna wysokość zrównałaby miesiąc, w którym dużo
                                         odłożono, z miesiącem, w którym dużo przepuszczono.
                                         Dla słupków przychodów górny segment jest pusty. -->
                                    <VerticalStackLayout VerticalOptions="End" HorizontalOptions="Fill"
                                                         Spacing="1">
                                        <BoxView HorizontalOptions="Fill"
                                                 HeightRequest="{Binding SavedHeight}"
                                                 IsVisible="{Binding HasSaved}"
                                                 Color="{Binding SavedColor}" CornerRadius="3,3,0,0" />
                                        <BoxView HorizontalOptions="Fill"
                                                 HeightRequest="{Binding BarHeight}"
                                                 Color="{Binding BarColor}" CornerRadius="3,3,0,0" />
                                    </VerticalStackLayout>
                                </Grid>
                                <Label Text="{Binding Label}" Style="{StaticResource Caption}"
                                       HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </Border>

            <Label Text="Przychody — 6 miesięcy" Style="{StaticResource SectionHeader}"
                   Margin="4,14,4,0" />
            <Border Style="{StaticResource Card}" Margin="0">
                <HorizontalStackLayout Spacing="6" HorizontalOptions="Center"
                                       BindableLayout.ItemsSource="{Binding IncomeBars}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:MonthBar">
                            <VerticalStackLayout WidthRequest="44" Spacing="5">
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectCommand}"
                                                          CommandParameter="{Binding SelectParameter}" />
                                </VerticalStackLayout.GestureRecognizers>
                                <Grid HeightRequest="120">
                                    <!-- Dwa segmenty: odłożone na górze, wydane pod spodem.
                                         Jedna wysokość zrównałaby miesiąc, w którym dużo
                                         odłożono, z miesiącem, w którym dużo przepuszczono.
                                         Dla słupków przychodów górny segment jest pusty. -->
                                    <VerticalStackLayout VerticalOptions="End" HorizontalOptions="Fill"
                                                         Spacing="1">
                                        <BoxView HorizontalOptions="Fill"
                                                 HeightRequest="{Binding SavedHeight}"
                                                 IsVisible="{Binding HasSaved}"
                                                 Color="{Binding SavedColor}" CornerRadius="3,3,0,0" />
                                        <BoxView HorizontalOptions="Fill"
                                                 HeightRequest="{Binding BarHeight}"
                                                 Color="{Binding BarColor}" CornerRadius="3,3,0,0" />
                                    </VerticalStackLayout>
                                </Grid>
                                <Label Text="{Binding Label}" Style="{StaticResource Caption}"
                                       HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </Border>

            <Label Text="{Binding TopHeader}" Style="{StaticResource SectionHeader}"
                   Margin="4,14,4,0" />
            <!-- Lista odpowiada na pytanie „na co wydaję”, a „Rezerwy” stały na niej
                 na stałe na pierwszym miejscu i wypychały z widoku prawdziwe kategorie. -->
            <Label Text="Bez odłożonego na rezerwę — ta kwota stoi wyżej, osobno. Stuknij kategorię, by zobaczyć jej transakcje."
                   Style="{StaticResource Caption}" Margin="4,0,4,2" />
            <Border Style="{StaticResource Card}" Margin="0">
                <VerticalStackLayout Spacing="14" BindableLayout.ItemsSource="{Binding TopCategories}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:TopCatRow">
                            <VerticalStackLayout Spacing="5">
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenCommand}"
                                                          CommandParameter="{Binding OpenParameter}" />
                                </VerticalStackLayout.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                    <Label Grid.Column="0" Text="{Binding CategoryName}"
                                           Style="{StaticResource RowTitle}" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding AmountDisplay}"
                                           Style="{StaticResource RowValue}" VerticalOptions="Center" />
                                    <Label Grid.Column="2" Text="›" Style="{StaticResource Secondary}"
                                           VerticalOptions="Center" />
                                </Grid>
                                <ProgressBar Progress="{Binding FillRatio}" HeightRequest="4"
                                             ProgressColor="{StaticResource Negative}" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
