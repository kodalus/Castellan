<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Castellan.App.ViewModels"
             x:Class="Castellan.App.Views.AddDebtPage"
             x:DataType="vm:AddDebtViewModel"
             Title="Nowe zobowiązanie">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Zapisz" Command="{Binding SaveCommand}" />
        <ToolbarItem Text="Anuluj" Command="{Binding CancelCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource FormBody}">

            <Border Style="{StaticResource ErrorBanner}" IsVisible="{Binding HasError}">
                <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
            </Border>

            <VerticalStackLayout Style="{StaticResource Field}">
                <Label Text="Nazwa" Style="{StaticResource FieldLabel}" />
                <Entry Text="{Binding Name}" Placeholder="np. Kredyt gotówkowy ING" />
            </VerticalStackLayout>

            <VerticalStackLayout Style="{StaticResource Field}">
                <Label Text="Rodzaj" Style="{StaticResource FieldLabel}" />
                <Picker ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind}"
                        ItemDisplayBinding="{Binding Display}" />
            </VerticalStackLayout>

            <VerticalStackLayout Style="{StaticResource Field}">
                <Label Text="Pozostało do spłaty (zł)" Style="{StaticResource FieldLabel}" />
                <Entry Text="{Binding InitialAmountText}" Keyboard="Numeric" Placeholder="np. 12000" />
                <Label Text="Wpisz kwotę, którą widzisz dziś w banku — od niej liczony jest postęp spłaty."
                       Style="{StaticResource FieldHint}" />
            </VerticalStackLayout>

            <VerticalStackLayout Style="{StaticResource Field}">
                <Label Text="Rata miesięczna (zł)" Style="{StaticResource FieldLabel}" />
                <Entry Text="{Binding InstallmentText}" Keyboard="Numeric" Placeholder="np. 350" />
                <Label Text="Możesz zostawić puste, jeśli nie ma ustalonego harmonogramu — wtedy nie policzymy terminu spłaty."
                       Style="{StaticResource FieldHint}" />
            </VerticalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
