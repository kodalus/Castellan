<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Castellan.App.ViewModels"
             x:Class="Castellan.App.Views.ReconcileAccountPage"
             x:DataType="vm:ReconcileAccountViewModel"
             Title="Uzgodnienie">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Zapisz" Command="{Binding SaveCommand}" />
        <ToolbarItem Text="Anuluj" Command="{Binding CancelCommand}" />
    </ContentPage.ToolbarItems>

    <VerticalStackLayout Padding="16" Spacing="20">

        <Label Text="{Binding AccountName}"
               FontSize="20" FontAttributes="Bold"
               HorizontalOptions="Center" />

        <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E0E0E0, Dark=#444}" />

        <VerticalStackLayout Spacing="6">
            <Label Text="Saldo faktyczne z aplikacji banku (zł)"
                   FontSize="13" TextColor="Gray" />
            <Entry x:Name="BalanceEntry"
                   Text="{Binding ActualBalanceText}"
                   Keyboard="Numeric"
                   Placeholder="0,00"
                   FontSize="20" />
        </VerticalStackLayout>

        <Label Text="Podaj dokładne saldo konta widoczne w aplikacji bankowej. Ewentualne rozbieżności zostaną zapisane jako transakcja Niezidentyfikowane."
               FontSize="12" TextColor="Gray" />

    </VerticalStackLayout>

</ContentPage>
