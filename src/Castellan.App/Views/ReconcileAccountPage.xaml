<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Castellan.App.ViewModels"
             x:Class="Castellan.App.Views.ReconcileAccountPage"
             x:DataType="vm:ReconcileAccountViewModel"
             Title="Uzgodnienie">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Zapisz" Command="{Binding SaveCommand}" />
        <ToolbarItem Text="Anuluj" Command="{Binding CancelCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource FormBody}">

            <Label Text="{Binding AccountName}" Style="{StaticResource Title}" />

            <VerticalStackLayout Style="{StaticResource Field}">
                <Label Text="Saldo z aplikacji banku (zł)" Style="{StaticResource FieldLabel}" />
                <Entry x:Name="BalanceEntry" Text="{Binding ActualBalanceText}" Keyboard="Numeric"
                       Placeholder="0,00" FontSize="{StaticResource SizeTitle}" />
                <Label Text="Przepisz dokładnie to, co pokazuje bank. Różnicę zapiszemy jako transakcję „Nierozpoznane”, żeby saldo się zgadzało."
                       Style="{StaticResource FieldHint}" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
