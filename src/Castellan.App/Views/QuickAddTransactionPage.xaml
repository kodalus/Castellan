<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Castellan.App.ViewModels"
             x:Class="Castellan.App.Views.QuickAddTransactionPage"
             x:DataType="vm:QuickAddTransactionViewModel"
             Title="Szybki wydatek">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Anuluj" Command="{Binding CancelCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="16,12,16,16" RowSpacing="12">

        <!-- Ten ekran obsługuje się jedną ręką przy kasie: kwota jest ogromna,
             kategorie to duże cele do trafienia kciukiem, potwierdzenie na dole. -->
        <VerticalStackLayout Grid.Row="0" Style="{StaticResource Field}">
            <Label Text="Kwota (zł)" Style="{StaticResource FieldLabel}" />
            <Entry Text="{Binding AmountText}" Keyboard="Numeric" Placeholder="0,00"
                   FontSize="{StaticResource SizeHero}" FontFamily="OpenSansSemibold" />
        </VerticalStackLayout>

        <Label Grid.Row="1" Text="{Binding SelectedCategoryName, StringFormat='Kategoria: {0}'}"
               Style="{StaticResource Secondary}" />

        <CollectionView Grid.Row="2" ItemsSource="{Binding Categories}">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="2"
                                 HorizontalItemSpacing="8" VerticalItemSpacing="8" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:CategoryButton">
                    <Button Text="{Binding Name}"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:QuickAddTransactionViewModel}}, Path=SelectCategoryCommand}"
                            CommandParameter="{Binding .}"
                            Style="{StaticResource GhostButton}"
                            HeightRequest="52" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="3" Text="Gotowe" Command="{Binding SaveCommand}"
                FontSize="{StaticResource SizeValue}" HeightRequest="54" />

    </Grid>

</ContentPage>
