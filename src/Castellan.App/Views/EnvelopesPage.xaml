<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:Castellan.App.Resources.Strings"
             xmlns:vm="clr-namespace:Castellan.App.ViewModels"
             xmlns:usecases="clr-namespace:Castellan.Application.UseCases;assembly=Castellan.Application"
             x:Class="Castellan.App.Views.EnvelopesPage"
             x:DataType="vm:EnvelopesViewModel"
             Title="{x:Static strings:AppResources.Tab_Envelopes}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{x:Static strings:AppResources.Envelopes_Plan}" Command="{Binding PlanMonthCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="0">

        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="8,10,8,4">
            <Button Grid.Column="0" Text="‹" Style="{StaticResource StepperButton}"
                    Command="{Binding PreviousMonthCommand}" />
            <Label Grid.Column="1" Text="{Binding CurrentMonthDisplay}"
                   Style="{StaticResource SectionHeader}"
                   HorizontalTextAlignment="Center" VerticalOptions="Center" />
            <Button Grid.Column="2" Text="›" Style="{StaticResource StepperButton}"
                    Command="{Binding NextMonthCommand}" />
        </Grid>

        <!-- Trzy liczby miesiąca w jednym rzędzie, każda tak samo cicha —
             żadna z nich nie jest ważniejsza od kopert pod spodem. -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="8" Margin="12,4,12,10"
              IsVisible="{Binding HasData}">
            <Border Grid.Column="0" Style="{StaticResource StatTile}">
                <VerticalStackLayout Spacing="3">
                    <Label Text="Wydane" Style="{StaticResource Caption}" />
                    <Label Text="{Binding TotalActualDisplay}" Style="{StaticResource RowValue}"
                           HorizontalTextAlignment="Start" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource StatTile}">
                <VerticalStackLayout Spacing="3">
                    <Label Text="W planie" Style="{StaticResource Caption}" />
                    <Label Text="{Binding MonthData.TotalPlanned}" Style="{StaticResource RowValue}"
                           HorizontalTextAlignment="Start" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource StatTile}">
                <VerticalStackLayout Spacing="3">
                    <Label Text="Nieprzydzielone" Style="{StaticResource Caption}" />
                    <Label Text="{Binding MonthData.RemainingToAllocate}" Style="{StaticResource RowValue}"
                           HorizontalTextAlignment="Start" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <CollectionView Grid.Row="2" ItemsSource="{Binding MonthData.Envelopes}" Margin="16,0">
            <CollectionView.EmptyView>
                <Label Text="{x:Static strings:AppResources.Envelopes_Empty}" Style="{StaticResource EmptyState}" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="usecases:EnvelopeOverview">
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="5" Padding="0,10">

                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Label Grid.Column="0" Text="{Binding CategoryName}"
                                   Style="{StaticResource RowTitle}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding RemainingDisplay}"
                                   Style="{StaticResource RowValue}" VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsOverBudget}" Value="True">
                                        <Setter Property="TextColor" Value="{StaticResource Negative}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Grid>

                        <ProgressBar Grid.Row="1" Progress="{Binding SpentRatio}" HeightRequest="4"
                                     ProgressColor="{Binding SpentFraction, Converter={StaticResource SpentFractionToColor}}" />

                        <Label Grid.Row="2" Text="{Binding ProgressLabel}" Style="{StaticResource Caption}" />

                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
