<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:Castellan.App.Resources.Strings"
             xmlns:vm="clr-namespace:Castellan.App.ViewModels"
             xmlns:usecases="clr-namespace:Castellan.Application.UseCases;assembly=Castellan.Application"
             xmlns:converters="clr-namespace:Castellan.App.Converters"
             x:Class="Castellan.App.Views.EnvelopesPage"
             x:DataType="vm:EnvelopesViewModel"
             Title="{x:Static strings:AppResources.Tab_Envelopes}">

    <ContentPage.Resources>
        <converters:SpentFractionToColorConverter x:Key="SpentFractionToColor" />
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{x:Static strings:AppResources.Envelopes_Plan}" Command="{Binding PlanMonthCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Month navigation -->
        <HorizontalStackLayout Grid.Row="0" HorizontalOptions="Center" Margin="0,12,0,8" Spacing="12">
            <Button Text="‹" Command="{Binding PreviousMonthCommand}" WidthRequest="40" />
            <Label Text="{Binding CurrentMonthDisplay}" VerticalOptions="Center" FontSize="16" FontAttributes="Bold" />
            <Button Text="›" Command="{Binding NextMonthCommand}" WidthRequest="40" />
        </HorizontalStackLayout>

        <!-- Summary card -->
        <Border Grid.Row="1" Margin="12,0,12,8" Padding="14,12"
                StrokeShape="RoundRectangle 10" IsVisible="{Binding HasData}">
            <VerticalStackLayout Spacing="10">
                <Grid ColumnDefinitions="*,*,*">
                    <VerticalStackLayout Grid.Column="0" HorizontalOptions="Start" Spacing="2">
                        <Label Text="Wydane" FontSize="11" TextColor="Gray" />
                        <Label Text="{Binding TotalActualDisplay}" FontSize="15" FontAttributes="Bold" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="2">
                        <Label Text="Zaplanowane" FontSize="11" TextColor="Gray" HorizontalOptions="Center" />
                        <Label Text="{Binding MonthData.TotalPlanned}" FontSize="15" FontAttributes="Bold" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2" HorizontalOptions="End" Spacing="2">
                        <Label Text="Nieprzydzielone" FontSize="11" TextColor="Gray" HorizontalOptions="End" />
                        <Label Text="{Binding MonthData.RemainingToAllocate}" FontSize="15" FontAttributes="Bold" HorizontalOptions="End" />
                    </VerticalStackLayout>
                </Grid>
                <ProgressBar Progress="{Binding TotalSpentRatio}" ProgressColor="#2196F3" HeightRequest="6" />
            </VerticalStackLayout>
        </Border>

        <!-- Envelopes list -->
        <CollectionView Grid.Row="2" ItemsSource="{Binding MonthData.Envelopes}" Margin="12,0,12,0">
            <CollectionView.EmptyView>
                <Label Text="{x:Static strings:AppResources.Envelopes_Empty}"
                       HorizontalOptions="Center" VerticalOptions="Center"
                       TextColor="Gray" Margin="0,40" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="usecases:EnvelopeOverview">
                    <Border Margin="0,0,0,8" Padding="14,12" StrokeShape="RoundRectangle 8">
                        <VerticalStackLayout Spacing="6">

                            <!-- Category name + remaining amount -->
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0"
                                       Text="{Binding CategoryName}"
                                       FontSize="15" FontAttributes="Bold"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="{Binding RemainingDisplay}"
                                       FontSize="15" FontAttributes="Bold"
                                       VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding IsOverBudget}"
                                                     Value="True">
                                            <Setter Property="TextColor" Value="#F44336" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Grid>

                            <!-- Progress bar -->
                            <ProgressBar Progress="{Binding SpentRatio}"
                                         ProgressColor="{Binding SpentFraction, Converter={StaticResource SpentFractionToColor}}"
                                         HeightRequest="6" />

                            <!-- Spent / planned caption -->
                            <Label Text="{Binding ProgressLabel}"
                                   FontSize="11" TextColor="Gray" />

                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
