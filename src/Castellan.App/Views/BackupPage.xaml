<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Castellan.App.ViewModels"
             x:Class="Castellan.App.Views.BackupPage"
             x:DataType="vm:BackupViewModel"
             Title="Kopia zapasowa">

    <ScrollView>
        <VerticalStackLayout Padding="12,12,12,24" Spacing="12">

            <Border Style="{StaticResource Card}" Margin="0">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Eksport danych" Style="{StaticResource Title}" />
                    <Label Style="{StaticResource Secondary}"
                           Text="Zapisuje wszystko — konta, transakcje, koperty, fundusze, aktywa i zobowiązania — do jednego pliku JSON. Możesz go trzymać w chmurze albo wysłać sobie mailem." />
                    <Button Text="Eksportuj" Command="{Binding ExportCommand}" HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Border>

            <!-- Import kasuje wszystko, co jest w aplikacji, więc karta ma koralową
                 obwódkę i przycisk w kolorze ostrzeżenia — inaczej wyglądałaby
                 identycznie jak nieszkodliwy eksport tuż nad nią. -->
            <Border Style="{StaticResource Card}" Margin="0"
                    Stroke="{StaticResource NegativeBrush}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Import danych" Style="{StaticResource Title}" />
                    <Label Style="{StaticResource Secondary}"
                           Text="Wczytuje dane z pliku JSON i zastępuje nimi wszystko, co jest teraz w aplikacji. Tej operacji nie da się cofnąć — rób to po reinstalacji albo na nowym telefonie." />
                    <Button Text="Importuj z pliku" Command="{Binding ImportCommand}"
                            Style="{StaticResource DangerButton}" HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0" IsVisible="{Binding HasStatus}">
                <Label Text="{Binding StatusMessage}" Style="{StaticResource Secondary}" />
            </Border>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
