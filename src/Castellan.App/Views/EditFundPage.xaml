<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Castellan.App.ViewModels"
             x:Class="Castellan.App.Views.EditFundPage"
             x:DataType="vm:EditFundViewModel"
             Title="Edytuj fundusz">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Zapisz" Command="{Binding SaveCommand}" />
        <ToolbarItem Text="Anuluj" Command="{Binding CancelCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource FormBody}">

            <Border Style="{StaticResource ErrorBanner}" IsVisible="{Binding HasError}">
                <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
            </Border>

            <!-- Zebrane saldo nie jest polem — edycja parametrów nigdy go nie rusza,
                 więc stoi tu jako fakt, a nie coś do wpisania. -->
            <Border Style="{StaticResource StatTile}">
                <VerticalStackLayout Spacing="3">
                    <Label Text="Zebrane" Style="{StaticResource SectionHeader}" />
                    <Label Text="{Binding BalanceDisplay}" Style="{StaticResource RowValue}"
                           HorizontalTextAlignment="Start" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Style="{StaticResource Field}">
                <Label Text="Nazwa funduszu" Style="{StaticResource FieldLabel}" />
                <Entry Text="{Binding Name}" />
            </VerticalStackLayout>

            <VerticalStackLayout Style="{StaticResource Field}">
                <Label Text="Rodzaj" Style="{StaticResource FieldLabel}" />
                <Picker ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind}"
                        ItemDisplayBinding="{Binding Display}" />
            </VerticalStackLayout>

            <VerticalStackLayout Style="{StaticResource Field}">
                <Label Text="Kwota docelowa (zł)" Style="{StaticResource FieldLabel}" />
                <Entry Text="{Binding TargetAmountText}" Keyboard="Numeric" />
            </VerticalStackLayout>

            <VerticalStackLayout Style="{StaticResource Field}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                        <Label Text="Zbieram bez terminu" Style="{StaticResource RowTitle}" />
                        <Label Text="Dla poduszki bezpieczeństwa: cel bez daty. Nie będzie raty ani ostrzeżeń o opóźnieniu."
                               Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" IsToggled="{Binding IsOpenEnded}" VerticalOptions="Center" />
                </Grid>
            </VerticalStackLayout>

            <VerticalStackLayout Style="{StaticResource Field}" IsVisible="{Binding HasDeadline}">
                <Label Text="Termin" Style="{StaticResource FieldLabel}" />
                <DatePicker Date="{Binding Deadline}" Format="MMMM yyyy"
                            MinimumDate="2025-01-01" MaximumDate="2035-12-31" />
                <Label Text="Kiedy będą potrzebne pieniądze — od tego liczy się miesięczna rata."
                       Style="{StaticResource FieldHint}" />
            </VerticalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
