<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:Castellan.App.Resources.Strings"
             xmlns:vm="clr-namespace:Castellan.App.ViewModels"
             xmlns:usecases="clr-namespace:Castellan.Application.UseCases;assembly=Castellan.Application"
             x:Class="Castellan.App.Views.DashboardPage"
             x:DataType="vm:DashboardViewModel"
             Title="{x:Static strings:AppResources.Tab_Dashboard}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Przychody" Command="{Binding OpenIncomeCommand}" Order="Secondary" Priority="0" />
        <ToolbarItem Text="Statystyki" Command="{Binding OpenStatisticsCommand}" Order="Secondary" Priority="1" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*" RowSpacing="0">

        <Border Grid.Row="0" Style="{StaticResource WarningBanner}"
                IsVisible="{Binding IsNotificationWarningVisible}">
            <Label Style="{StaticResource WarningText}"
                   Text="Powiadomienia bankowe nie zostały odebrane od ponad doby. Sprawdź uprawnienia w zakładce Skrzynka." />
        </Border>

        <!-- Miesiąc jest kontekstem dla wszystkiego poniżej, więc stoi na samej górze
             i celowo jest cichy — to nie jest liczba, tylko etykieta. -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="8,10,8,2">
            <Button Grid.Column="0" Text="‹" Style="{StaticResource StepperButton}"
                    Command="{Binding PreviousMonthCommand}" />
            <Label Grid.Column="1" Text="{Binding CurrentMonthDisplay}"
                   Style="{StaticResource SectionHeader}"
                   HorizontalTextAlignment="Center" VerticalOptions="Center" />
            <Button Grid.Column="2" Text="›" Style="{StaticResource StepperButton}"
                    Command="{Binding NextMonthCommand}" />
        </Grid>

        <!-- Jedna liczba, po którą sięga się codziennie: ile jeszcze mogę wydać.
             Reszta kwot to kontekst i schodzi niżej w hierarchii. -->
        <VerticalStackLayout Grid.Row="2" Margin="16,6,16,14" Spacing="3">
            <Label Text="Pozostało do wydania" Style="{StaticResource SectionHeader}" />
            <Label Text="{Binding MonthData.RemainingToSpend}" Style="{StaticResource Hero}" />
            <Label Style="{StaticResource Secondary}">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="{Binding MonthData.TotalSpent}" />
                        <Span Text=" wydane z " />
                        <Span Text="{Binding MonthData.TotalPlanned}" />
                        <Span Text=" w planie" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>
            <ProgressBar Progress="{Binding MonthData.SpentRatio}" Margin="0,7,0,0"
                         ProgressColor="{Binding MonthData.SpentFraction, Converter={StaticResource SpentFractionToColor}}" />
        </VerticalStackLayout>

        <Grid Grid.Row="3" ColumnDefinitions="*,*" Margin="12,0,12,6" ColumnSpacing="8">
            <Border Grid.Column="0" Style="{StaticResource StatTile}">
                <VerticalStackLayout Spacing="3">
                    <Label Text="{x:Static strings:AppResources.Dashboard_AvailableFunds}" Style="{StaticResource Caption}" />
                    <Label Text="{Binding MonthData.AvailableFunds}" Style="{StaticResource RowValue}"
                           HorizontalTextAlignment="Start" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource StatTile}">
                <VerticalStackLayout Spacing="3">
                    <Label Text="{x:Static strings:AppResources.Dashboard_RemainingToAllocate}" Style="{StaticResource Caption}" />
                    <Label Text="{Binding MonthData.RemainingToAllocate}" Style="{StaticResource RowValue}"
                           HorizontalTextAlignment="Start" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Pasek długu ląduje na ekranie otwieranym codziennie, więc spojrzenie na
             zobowiązania nigdy nie wymaga świadomego wejścia w osobną zakładkę. -->
        <Border Grid.Row="4" Style="{StaticResource CardRow}"
                IsVisible="{Binding HasDebts}"
                BackgroundColor="{StaticResource NegativeWash}"
                Stroke="{StaticResource NegativeBrush}">
            <Grid ColumnDefinitions="*,Auto">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenDebtPlanCommand}" />
                </Grid.GestureRecognizers>
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="{Binding DebtSummaryDisplay}" Style="{StaticResource NegativeValue}"
                           HorizontalTextAlignment="Start" />
                    <Label Text="{Binding DebtFreedomDisplay}" Style="{StaticResource Caption}" />
                </VerticalStackLayout>
                <Label Grid.Column="1" Text="Plan spłaty ›" Style="{StaticResource Secondary}"
                       TextColor="{StaticResource Negative}" VerticalOptions="Center" />
            </Grid>
        </Border>

        <Label Grid.Row="5" Text="Koperty" Style="{StaticResource SectionHeader}" Margin="16,12,16,6" />

        <CollectionView Grid.Row="6" ItemsSource="{Binding MonthData.Envelopes}" Margin="16,0,16,0">
            <CollectionView.EmptyView>
                <Label Text="{x:Static strings:AppResources.Dashboard_NoBudget}" Style="{StaticResource EmptyState}" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="usecases:EnvelopeOverview">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="6" Padding="0,9">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="{Binding CategoryName}" Style="{StaticResource RowTitle}"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1" Style="{StaticResource Secondary}" VerticalOptions="Center">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding ActualDisplay}" TextColor="{StaticResource TextPrimary}" />
                                        <Span Text=" / " />
                                        <Span Text="{Binding PlannedDisplay}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </Grid>
                        <ProgressBar Grid.Row="1" Progress="{Binding SpentRatio}" HeightRequest="4"
                                     ProgressColor="{Binding SpentFraction, Converter={StaticResource SpentFractionToColor}}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
