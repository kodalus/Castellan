<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:Castellan.App.Resources.Strings"
             xmlns:vm="clr-namespace:Castellan.App.ViewModels"
             xmlns:usecases="clr-namespace:Castellan.Application.UseCases;assembly=Castellan.Application"
             x:Class="Castellan.App.Views.DashboardPage"
             x:DataType="vm:DashboardViewModel"
             Title="{x:Static strings:AppResources.Tab_Dashboard}">

    <Grid RowDefinitions="Auto,Auto,*">

        <HorizontalStackLayout Grid.Row="0" HorizontalOptions="Center" Margin="0,12,0,4" Spacing="12">
            <Button Text="‹" Command="{Binding PreviousMonthCommand}" WidthRequest="40" />
            <Label Text="{Binding CurrentMonthDisplay}" VerticalOptions="Center" FontSize="16" FontAttributes="Bold" />
            <Button Text="›" Command="{Binding NextMonthCommand}" WidthRequest="40" />
        </HorizontalStackLayout>

        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" Margin="12,4" ColumnSpacing="8">
            <Border Grid.Column="0" Padding="8" Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#444}" StrokeShape="Rectangle">
                <VerticalStackLayout Spacing="2">
                    <Label Text="{x:Static strings:AppResources.Dashboard_AvailableFunds}" FontSize="11" TextColor="Gray" />
                    <Label Text="{Binding MonthData.AvailableFunds}" FontSize="13" FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="1" Padding="8" Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#444}" StrokeShape="Rectangle">
                <VerticalStackLayout Spacing="2">
                    <Label Text="{x:Static strings:AppResources.Dashboard_TotalPlanned}" FontSize="11" TextColor="Gray" />
                    <Label Text="{Binding MonthData.TotalPlanned}" FontSize="13" FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="2" Padding="8" Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#444}" StrokeShape="Rectangle">
                <VerticalStackLayout Spacing="2">
                    <Label Text="{x:Static strings:AppResources.Dashboard_RemainingToAllocate}" FontSize="11" TextColor="Gray" />
                    <Label Text="{Binding MonthData.RemainingToAllocate}" FontSize="13" FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <CollectionView Grid.Row="2" ItemsSource="{Binding MonthData.Envelopes}" Margin="12,4">
            <CollectionView.EmptyView>
                <Label Text="{x:Static strings:AppResources.Dashboard_NoBudget}"
                       HorizontalOptions="Center" VerticalOptions="Center" TextColor="Gray" Margin="0,40" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="usecases:EnvelopeOverview">
                    <Grid RowDefinitions="Auto,6" Padding="4,10">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto">
                            <Label Grid.Column="0" Text="{Binding CategoryName}" FontSize="14" />
                            <Label Grid.Column="1" Text="{Binding ActualDisplay}" FontSize="13" HorizontalOptions="End" Margin="8,0" />
                            <Label Grid.Column="2" Text="{Binding PlannedDisplay}" FontSize="13" TextColor="Gray" HorizontalOptions="End" />
                        </Grid>
                        <ProgressBar Grid.Row="1" Progress="{Binding SpentRatio}"
                                     ProgressColor="{AppThemeBinding Light=#512BD4, Dark=#9B8AE0}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
