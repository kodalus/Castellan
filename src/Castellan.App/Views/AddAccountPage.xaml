<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Castellan.App.ViewModels"
             x:Class="Castellan.App.Views.AddAccountPage"
             x:DataType="vm:AddAccountViewModel"
             Title="Nowe konto">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Zapisz" Command="{Binding SaveCommand}" />
        <ToolbarItem Text="Anuluj" Command="{Binding CancelCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource FormBody}">

            <VerticalStackLayout Style="{StaticResource Field}">
                <Label Text="Nazwa" Style="{StaticResource FieldLabel}" />
                <Entry Text="{Binding Name}" Placeholder="np. ING osobiste" />
            </VerticalStackLayout>

            <VerticalStackLayout Style="{StaticResource Field}">
                <Label Text="Typ konta" Style="{StaticResource FieldLabel}" />
                <Picker ItemsSource="{Binding KindOptions}" SelectedIndex="{Binding KindIndex}" />
            </VerticalStackLayout>

            <VerticalStackLayout Style="{StaticResource Field}">
                <Label Text="Bank" Style="{StaticResource FieldLabel}" />
                <Picker ItemsSource="{Binding BankOptions}" SelectedIndex="{Binding BankIndex}" />
                <Entry Text="{Binding CustomBank}" Placeholder="np. Bank Spółdzielczy w Brodnicy"
                       IsVisible="{Binding IsCustomBank}" />
                <Label Text="Dzięki temu powiadomienia z tego banku trafią na właściwe konto, jakkolwiek je nazwiesz."
                       Style="{StaticResource FieldHint}" />
            </VerticalStackLayout>

            <VerticalStackLayout Style="{StaticResource Field}">
                <Label Text="Saldo (zł)" Style="{StaticResource FieldLabel}" />
                <Entry Text="{Binding BalanceText}" Keyboard="Numeric" />
                <Label Text="Stan konta na dziś — od niego liczą się kolejne transakcje."
                       Style="{StaticResource FieldHint}" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
