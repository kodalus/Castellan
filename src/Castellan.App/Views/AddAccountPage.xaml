<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Castellan.App.ViewModels"
             x:Class="Castellan.App.Views.AddAccountPage"
             x:DataType="vm:AddAccountViewModel"
             Title="Nowe konto">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Zapisz" Command="{Binding SaveCommand}" />
        <ToolbarItem Text="Anuluj" Command="{Binding CancelCommand}" />
    </ContentPage.ToolbarItems>

    <VerticalStackLayout Padding="16" Spacing="16">

        <VerticalStackLayout Spacing="4">
            <Label Text="Nazwa" FontSize="13" TextColor="Gray" />
            <Entry Text="{Binding Name}" Placeholder="Nazwa konta" />
        </VerticalStackLayout>

        <VerticalStackLayout Spacing="4">
            <Label Text="Typ konta" FontSize="13" TextColor="Gray" />
            <Picker ItemsSource="{Binding KindOptions}" SelectedIndex="{Binding KindIndex}" />
        </VerticalStackLayout>

        <VerticalStackLayout Spacing="4">
            <Label Text="Saldo (zł)" FontSize="13" TextColor="Gray" />
            <Entry Text="{Binding BalanceText}" Keyboard="Numeric" />
        </VerticalStackLayout>

    </VerticalStackLayout>
</ContentPage>
