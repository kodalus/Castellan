<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:Castellan.App.Resources.Strings"
             xmlns:vm="clr-namespace:Castellan.App.ViewModels"
             x:Class="Castellan.App.Views.AddTransactionPage"
             x:DataType="vm:AddTransactionViewModel"
             Title="{x:Static strings:AppResources.Transactions_AddTitle}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{x:Static strings:AppResources.Button_Save}" Command="{Binding SaveCommand}" />
        <ToolbarItem Text="{x:Static strings:AppResources.Button_Cancel}" Command="{Binding CancelCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource FormBody}">

            <!-- Zwrot kosztów jest osobnym trybem, a nie odmianą przychodu: kwota wraca
                 na konto, ale ma pomniejszyć kategorię, z której poszła pierwotna płatność. -->
            <HorizontalStackLayout Spacing="16">
                <RadioButton Content="Wydatek" GroupName="txKind"
                             IsChecked="{Binding IsExpense, Mode=TwoWay}" />
                <RadioButton Content="Przychód" GroupName="txKind"
                             IsChecked="{Binding IsIncome, Mode=TwoWay}" />
                <RadioButton Content="Zwrot" GroupName="txKind"
                             IsChecked="{Binding IsRefund, Mode=TwoWay}" />
            </HorizontalStackLayout>

            <VerticalStackLayout Style="{StaticResource Field}">
                <Label Text="{x:Static strings:AppResources.Transactions_Account}" Style="{StaticResource FieldLabel}" />
                <Picker ItemsSource="{Binding AccountOptions}" ItemDisplayBinding="{Binding Name}"
                        SelectedIndex="{Binding AccountIndex}" />
            </VerticalStackLayout>

            <VerticalStackLayout Style="{StaticResource Field}">
                <Label Text="{x:Static strings:AppResources.Transactions_Amount}" Style="{StaticResource FieldLabel}" />
                <Entry x:Name="AmountEntry" Text="{Binding AmountText}" Keyboard="Numeric" Placeholder="100,00" />
            </VerticalStackLayout>

            <VerticalStackLayout Style="{StaticResource Field}">
                <Label Text="{x:Static strings:AppResources.Transactions_Date}" Style="{StaticResource FieldLabel}" />
                <DatePicker Date="{Binding Date}" />
            </VerticalStackLayout>

            <VerticalStackLayout Style="{StaticResource Field}">
                <Label Text="{x:Static strings:AppResources.Transactions_Category}" Style="{StaticResource FieldLabel}" />
                <Label Text="Kategoria, z której odliczyć zwrot" Style="{StaticResource Caption}"
                       IsVisible="{Binding IsRefund}" />
                <Picker ItemsSource="{Binding CategoryOptions}" ItemDisplayBinding="{Binding Name}"
                        SelectedIndex="{Binding CategoryIndex}" />
            </VerticalStackLayout>

            <VerticalStackLayout Style="{StaticResource Field}">
                <Label Text="{x:Static strings:AppResources.Transactions_Note}" Style="{StaticResource FieldLabel}" />
                <Entry x:Name="NoteEntry" Text="{Binding Note}" />
            </VerticalStackLayout>

            <!-- Tylko na pulpicie. Tam pasek narzędzi trafia do belki tytułowej: trudno
                 go znaleźć i nie stoi w kolejce Taba, więc przy wpisywaniu z klawiatury
                 to jedyne wyjście bez myszy. Na telefonie pasek jest na wierzchu i
                 druga para tych samych przycisków była tylko powtórzeniem. -->
            <HorizontalStackLayout Spacing="8" IsVisible="{OnPlatform Default=False, WinUI=True}">
                <Button Text="{x:Static strings:AppResources.Button_Save}" Command="{Binding SaveCommand}" />
                <Button Text="{x:Static strings:AppResources.Button_Cancel}" Command="{Binding CancelCommand}"
                        Style="{StaticResource GhostButton}" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
