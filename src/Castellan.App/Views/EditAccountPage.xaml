<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Castellan.App.ViewModels"
             x:Class="Castellan.App.Views.EditAccountPage"
             x:DataType="vm:EditAccountViewModel"
             Title="Edycja konta">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Zapisz" Command="{Binding SaveCommand}" />
        <ToolbarItem Text="Anuluj" Command="{Binding CancelCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource FormBody}">

            <Border Style="{StaticResource ErrorBanner}" IsVisible="{Binding HasError}">
                <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
            </Border>

            <VerticalStackLayout Style="{StaticResource Field}">
                <Label Text="Nazwa" Style="{StaticResource FieldLabel}" />
                <Entry Text="{Binding Name}" Placeholder="np. Revolut wspólne" />
                <Label Style="{StaticResource FieldHint}"
                       Text="Zmiana nazwy nie rusza żadnej transakcji — wiszą na koncie, nie na jego nazwie." />
            </VerticalStackLayout>

            <VerticalStackLayout Style="{StaticResource Field}">
                <Label Text="Typ konta" Style="{StaticResource FieldLabel}" />
                <Picker ItemsSource="{Binding KindOptions}" SelectedIndex="{Binding KindIndex}" />
                <Label Style="{StaticResource FieldHint}"
                       Text="Przy przelewie na konto oszczędnościowe aplikacja pyta, czy odkładasz — dla rachunku bieżącego nie pyta." />
            </VerticalStackLayout>

            <VerticalStackLayout Style="{StaticResource Field}">
                <Label Text="Bank" Style="{StaticResource FieldLabel}" />
                <Picker ItemsSource="{Binding BankOptions}" SelectedIndex="{Binding BankIndex}" />
                <Label Style="{StaticResource FieldHint}"
                       Text="Po co: powiadomienie trafi na właściwe konto niezależnie od tego, jak je nazwałaś. Bez tego aplikacja zgaduje po nazwie — a przy dwóch kontach w jednym banku zgadywanie bywa błędne." />
            </VerticalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
