<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Castellan.App.ViewModels"
             x:Class="Castellan.App.Views.CategoryRulesPage"
             x:DataType="vm:CategoryRulesViewModel"
             Title="Reguły kategorii">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="+" Command="{Binding AddRuleCommand}" />
    </ContentPage.ToolbarItems>

    <CollectionView ItemsSource="{Binding Rules}" Margin="12">
        <CollectionView.EmptyView>
            <Label Text="Brak reguł — dodaj pierwszą za pomocą przycisku +."
                   HorizontalOptions="Center" VerticalOptions="Center"
                   TextColor="Gray" HorizontalTextAlignment="Center" Margin="24,40" />
        </CollectionView.EmptyView>
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="vm:CategoryRuleRow">
                <SwipeView>
                    <SwipeView.RightItems>
                        <SwipeItems>
                            <SwipeItem Text="Usuń" BackgroundColor="#E53935"
                                       Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CategoryRulesViewModel}}, Path=DeleteRuleCommand}"
                                       CommandParameter="{Binding .}" />
                        </SwipeItems>
                    </SwipeView.RightItems>
                    <Grid ColumnDefinitions="*,Auto" Padding="4,14" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="{Binding Pattern}" FontSize="15" FontAttributes="Bold" />
                            <Label Text="wzorzec (zawiera)" FontSize="11" TextColor="Gray" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="{Binding CategoryName}"
                               FontSize="13" TextColor="White" BackgroundColor="#555"
                               Padding="8,4" VerticalOptions="Center" />
                    </Grid>
                </SwipeView>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentPage>
