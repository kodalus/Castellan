<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Castellan.App.ViewModels"
             x:Class="Castellan.App.Views.CategoryRulesPage"
             x:DataType="vm:CategoryRulesViewModel"
             Title="Reguły kategorii">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="+" Command="{Binding AddRuleCommand}" />
    </ContentPage.ToolbarItems>

    <CollectionView ItemsSource="{Binding Rules}" Margin="16,8,16,0">
        <CollectionView.EmptyView>
            <Label Text="Brak reguł. Dodaj pierwszą tapując +." Style="{StaticResource EmptyState}" />
        </CollectionView.EmptyView>
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="vm:CategoryRuleRow">
                <SwipeView>
                    <SwipeView.RightItems>
                        <SwipeItems>
                            <SwipeItem Text="Usuń" BackgroundColor="{StaticResource NegativeDim}"
                                       Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CategoryRulesViewModel}}, Path=DeleteRuleCommand}"
                                       CommandParameter="{Binding .}" />
                        </SwipeItems>
                    </SwipeView.RightItems>
                    <Grid ColumnDefinitions="*,Auto" Padding="0,13" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding Pattern}" Style="{StaticResource RowTitle}" />
                            <Label Text="gdy nazwa sprzedawcy zawiera" Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="{Binding CategoryName}"
                               Style="{StaticResource Secondary}" VerticalOptions="Center" />
                    </Grid>
                </SwipeView>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentPage>
