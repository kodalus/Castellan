<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:Castellan.App.Resources.Strings"
             xmlns:vm="clr-namespace:Castellan.App.ViewModels"
             x:Class="Castellan.App.Views.PayDebtPage"
             x:DataType="vm:PayDebtViewModel"
             Title="Zapłać ratę">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Zapisz" Command="{Binding SaveCommand}" />
        <ToolbarItem Text="Anuluj" Command="{Binding CancelCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource FormBody}">

            <Border Style="{StaticResource ErrorBanner}" IsVisible="{Binding HasError}">
                <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
            </Border>

            <VerticalStackLayout Spacing="3">
                <Label Text="{Binding DebtName}" Style="{StaticResource Title}" />
                <Label Text="{Binding BalanceDisplay}" Style="{StaticResource NegativeCaption}" />
            </VerticalStackLayout>

            <Label Style="{StaticResource Secondary}"
                   Text="Zapisze wydatek w wybranej kopercie i jednocześnie zmniejszy saldo zobowiązania." />

            <VerticalStackLayout Style="{StaticResource Field}">
                <Label Text="{x:Static strings:AppResources.Transactions_Amount}" Style="{StaticResource FieldLabel}" />
                <Entry Text="{Binding AmountText}" Keyboard="Numeric" />
                <Label Text="Możesz wpisać więcej niż ratę — nadpłata skróci czas spłaty."
                       Style="{StaticResource FieldHint}" />
            </VerticalStackLayout>

            <VerticalStackLayout Style="{StaticResource Field}">
                <Label Text="{x:Static strings:AppResources.Transactions_Account}" Style="{StaticResource FieldLabel}" />
                <Picker ItemsSource="{Binding AccountOptions}" ItemDisplayBinding="{Binding Name}"
                        SelectedIndex="{Binding AccountIndex}" />
            </VerticalStackLayout>

            <VerticalStackLayout Style="{StaticResource Field}">
                <Label Text="{x:Static strings:AppResources.Transactions_Category}" Style="{StaticResource FieldLabel}" />
                <Picker ItemsSource="{Binding CategoryOptions}" ItemDisplayBinding="{Binding Name}"
                        SelectedIndex="{Binding CategoryIndex}" />
            </VerticalStackLayout>

            <VerticalStackLayout Style="{StaticResource Field}">
                <Label Text="{x:Static strings:AppResources.Transactions_Date}" Style="{StaticResource FieldLabel}" />
                <DatePicker Date="{Binding Date}" />
            </VerticalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
