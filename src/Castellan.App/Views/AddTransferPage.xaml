<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:Castellan.App.Resources.Strings"
             xmlns:vm="clr-namespace:Castellan.App.ViewModels"
             x:Class="Castellan.App.Views.AddTransferPage"
             x:DataType="vm:AddTransferViewModel"
             Title="Przelew między kontami">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{x:Static strings:AppResources.Button_Save}" Command="{Binding SaveCommand}" />
        <ToolbarItem Text="{x:Static strings:AppResources.Button_Cancel}" Command="{Binding CancelCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource FormBody}">

            <Border Style="{StaticResource ErrorBanner}" IsVisible="{Binding HasError}">
                <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
            </Border>

            <Label Style="{StaticResource Secondary}"
                   Text="Przelew własnych pieniędzy między kontami nie jest ani wydatkiem, ani przychodem — nie ruszy kopert ani podsumowania przychodów." />

            <VerticalStackLayout Style="{StaticResource Field}">
                <Label Text="Z konta" Style="{StaticResource FieldLabel}" />
                <Picker ItemsSource="{Binding FromOptions}" ItemDisplayBinding="{Binding Name}"
                        SelectedIndex="{Binding FromIndex}" />
            </VerticalStackLayout>

            <VerticalStackLayout Style="{StaticResource Field}">
                <Label Text="Na konto" Style="{StaticResource FieldLabel}" />
                <Picker ItemsSource="{Binding ToOptions}" ItemDisplayBinding="{Binding Name}"
                        SelectedIndex="{Binding ToIndex}" />
            </VerticalStackLayout>

            <VerticalStackLayout Style="{StaticResource Field}">
                <Label Text="{x:Static strings:AppResources.Transactions_Amount}" Style="{StaticResource FieldLabel}" />
                <Entry Text="{Binding AmountText}" Keyboard="Numeric" Placeholder="2000,00" />
            </VerticalStackLayout>

            <VerticalStackLayout Style="{StaticResource Field}">
                <Label Text="{x:Static strings:AppResources.Transactions_Date}" Style="{StaticResource FieldLabel}" />
                <DatePicker Date="{Binding Date}" />
            </VerticalStackLayout>

            <VerticalStackLayout Style="{StaticResource Field}">
                <Label Text="{x:Static strings:AppResources.Transactions_Note}" Style="{StaticResource FieldLabel}" />
                <Entry Text="{Binding Note}" Placeholder="np. wspólne zakupy" />
            </VerticalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
