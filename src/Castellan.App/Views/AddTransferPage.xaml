<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:Castellan.App.Resources.Strings"
             xmlns:vm="clr-namespace:Castellan.App.ViewModels"
             x:Class="Castellan.App.Views.AddTransferPage"
             x:DataType="vm:AddTransferViewModel"
             Title="Przelew między kontami">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{x:Static strings:AppResources.Button_Save}" Command="{Binding SaveCommand}" />
        <ToolbarItem Text="{x:Static strings:AppResources.Button_Cancel}" Command="{Binding CancelCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <Border IsVisible="{Binding HasError}"
                    BackgroundColor="#FFEBEE" Padding="12,8"
                    StrokeShape="RoundRectangle 6" Stroke="Transparent">
                <Label Text="{Binding ErrorMessage}" TextColor="#C62828" FontSize="13" />
            </Border>

            <Label Text="Przelew własnych pieniędzy między kontami nie jest ani wydatkiem, ani przychodem — nie wpłynie na koperty ani na podsumowanie przychodów."
                   FontSize="12" TextColor="Gray" />

            <VerticalStackLayout Spacing="4">
                <Label Text="Z konta" FontSize="13" TextColor="Gray" />
                <Picker ItemsSource="{Binding FromOptions}" ItemDisplayBinding="{Binding Name}"
                        SelectedIndex="{Binding FromIndex}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Na konto" FontSize="13" TextColor="Gray" />
                <Picker ItemsSource="{Binding ToOptions}" ItemDisplayBinding="{Binding Name}"
                        SelectedIndex="{Binding ToIndex}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="{x:Static strings:AppResources.Transactions_Amount}" FontSize="13" TextColor="Gray" />
                <Entry Text="{Binding AmountText}" Keyboard="Numeric" Placeholder="2000.00" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="{x:Static strings:AppResources.Transactions_Date}" FontSize="13" TextColor="Gray" />
                <DatePicker Date="{Binding Date}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="{x:Static strings:AppResources.Transactions_Note}" FontSize="13" TextColor="Gray" />
                <Entry Text="{Binding Note}" Placeholder="np. wspólne zakupy" />
            </VerticalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
