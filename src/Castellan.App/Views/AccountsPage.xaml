<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:Castellan.App.Resources.Strings"
             xmlns:vm="clr-namespace:Castellan.App.ViewModels"
             x:Class="Castellan.App.Views.AccountsPage"
             x:DataType="vm:AccountsViewModel"
             Title="{x:Static strings:AppResources.Tab_Accounts}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="+" Command="{Binding AddAccountCommand}" />
    </ContentPage.ToolbarItems>

    <CollectionView ItemsSource="{Binding Accounts}" Margin="12">
        <CollectionView.EmptyView>
            <Label Text="{x:Static strings:AppResources.Accounts_Empty}"
                   HorizontalOptions="Center" VerticalOptions="Center" TextColor="Gray" Margin="0,40" />
        </CollectionView.EmptyView>
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="vm:AccountRow">
                <Grid ColumnDefinitions="*,Auto" Padding="4,12">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="{Binding Name}" FontSize="15" FontAttributes="Bold" />
                        <Label Text="{Binding Kind}" FontSize="12" TextColor="Gray" />
                    </VerticalStackLayout>
                    <Label Grid.Column="1" Text="{Binding BalanceDisplay}" FontSize="15"
                           VerticalOptions="Center" HorizontalOptions="End" />
                </Grid>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentPage>
