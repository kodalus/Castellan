<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:Castellan.App.Resources.Strings"
             xmlns:vm="clr-namespace:Castellan.App.ViewModels"
             x:Class="Castellan.App.Views.AccountsPage"
             x:DataType="vm:AccountsViewModel"
             Title="{x:Static strings:AppResources.Tab_Accounts}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="+" Command="{Binding AddAccountCommand}" />
    </ContentPage.ToolbarItems>

    <CollectionView ItemsSource="{Binding Accounts}" Margin="0,8,0,0">
        <CollectionView.EmptyView>
            <Label Text="{x:Static strings:AppResources.Accounts_Empty}" Style="{StaticResource EmptyState}" />
        </CollectionView.EmptyView>
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="vm:AccountRow">
                <Border Style="{StaticResource CardRow}">
                    <VerticalStackLayout Spacing="10">

                        <!-- Saldo stoi samo w swojej kolumnie: to jedyna liczba w wierszu,
                             więc nic nie może jej zasłaniać. Akcje schodzą pod spód. -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding Name}" Style="{StaticResource RowTitle}" />
                                <Label Text="{Binding KindDisplay}" Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding BalanceDisplay}" Style="{StaticResource RowValue}" />
                                <Label Text="★ domyślne" Style="{StaticResource RowMeta}"
                                       TextColor="{StaticResource Brass}"
                                       IsVisible="{Binding IsDefault}" />
                            </VerticalStackLayout>
                        </Grid>

                        <HorizontalStackLayout Spacing="8">
                            <Button Text="Ustaw domyślne" Command="{Binding SetDefaultCommand}"
                                    Style="{StaticResource GhostButton}"
                                    IsVisible="{Binding IsNotDefault}" />
                            <Button Text="Uzgodnij" Command="{Binding ReconcileCommand}"
                                    Style="{StaticResource GhostButton}" />
                        </HorizontalStackLayout>

                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentPage>
