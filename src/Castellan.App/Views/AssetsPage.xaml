<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Castellan.App.ViewModels"
             x:Class="Castellan.App.Views.AssetsPage"
             x:DataType="vm:AssetsViewModel"
             Title="Majątek">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="+ Aktywo" Command="{Binding AddAssetCommand}" />
        <ToolbarItem Text="+ Zobowiązanie" Command="{Binding AddDebtCommand}" Order="Secondary" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="0,0,0,16">

            <!-- „Ile miesięcy wytrzymam” to jedyna liczba na tym ekranie, po którą
                 sięga się odruchowo — dlatego jest wielka, a złotówki pod nią. -->
            <Border Style="{StaticResource Card}" Margin="12,10,12,4">
                <VerticalStackLayout Spacing="3">
                    <Label Text="Poduszka finansowa" Style="{StaticResource SectionHeader}" />
                    <Label Text="{Binding TotalMonthsDisplay}" Style="{StaticResource Hero}" />
                    <Label Text="{Binding TotalValueDisplay}" Style="{StaticResource Secondary}" />
                    <Label Text="{Binding AvgExpenseDisplay}" Style="{StaticResource Caption}" />
                </VerticalStackLayout>
            </Border>

            <!-- Bez długów ta karta powtarzałaby tylko sumę aktywów. -->
            <Border Style="{StaticResource Card}" IsVisible="{Binding HasDebts}">
                <VerticalStackLayout Spacing="3">
                    <Label Text="Wartość netto" Style="{StaticResource SectionHeader}" />
                    <Label Text="{Binding NetWorthDisplay}" Style="{StaticResource SubHero}"
                           TextColor="{StaticResource Positive}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsNetWorthNegative}" Value="True">
                                <Setter Property="TextColor" Value="{StaticResource Negative}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Label Text="aktywa i fundusze minus zobowiązania" Style="{StaticResource Caption}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Brak aktywów. Dodaj pierwsze tapując +." Style="{StaticResource EmptyState}"
                   IsVisible="{Binding IsEmpty}" />

            <!-- ===== Aktywa według płynności ===== -->
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Tiers}" IsVisible="{Binding IsNotEmpty}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:CushionTierVm">
                        <VerticalStackLayout Margin="0,10,0,0">

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="16,0,16,4">
                                <Label Grid.Column="0" Text="{Binding LiquidityDisplay}"
                                       Style="{StaticResource SectionHeader}" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding CumulativeDisplay}"
                                       Style="{StaticResource RowMeta}" VerticalOptions="Center" />
                            </Grid>

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Assets}"
                                                 IsVisible="{Binding HasAssets}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AssetRowVm">
                                        <Border Style="{StaticResource CardRow}">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding UpdateCommand}"
                                                                          CommandParameter="{Binding Id}" />
                                                </Grid.GestureRecognizers>
                                                <Label Grid.Column="0" Text="{Binding Name}"
                                                       Style="{StaticResource RowTitle}" VerticalOptions="Center" />
                                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                    <Label Text="{Binding ValueDisplay}" Style="{StaticResource RowValue}" />
                                                    <Label Text="{Binding UpdatedDisplay}" Style="{StaticResource RowMeta}" />
                                                </VerticalStackLayout>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="16,4,16,0">
                                <Label Grid.Column="0" Text="{Binding TierValueDisplay}"
                                       Style="{StaticResource Caption}" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding MonthsTierDisplay}"
                                       Style="{StaticResource InfoCaption}" VerticalOptions="Center" />
                            </Grid>

                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- Fundusze celowo osobno od poduszki: te pieniądze mają już właściciela
                 (konkretny przyszły wydatek), więc nie są rezerwą na czarną godzinę. -->
            <VerticalStackLayout IsVisible="{Binding HasFunds}" Margin="0,14,0,0">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="16,0,16,4">
                    <Label Grid.Column="0" Text="Fundusze" Style="{StaticResource SectionHeader}"
                           VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{Binding FundsTotalDisplay}"
                           Style="{StaticResource RowMeta}" VerticalOptions="Center" />
                </Grid>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding FundRows}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:FundRowVm">
                            <Border Style="{StaticResource CardRow}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <Label Grid.Column="0" Text="{Binding Name}"
                                           Style="{StaticResource RowTitle}" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding ValueDisplay}"
                                           Style="{StaticResource RowValue}" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Zobowiązania: lustro funduszy — saldo maleje do zera. Kolejność od
                 najmniejszego (kula śnieżna): spłacony dług oddaje swoją ratę następnemu. -->
            <VerticalStackLayout IsVisible="{Binding HasDebts}" Margin="0,14,0,0">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="16,0,16,4">
                    <Label Grid.Column="0" Text="Zobowiązania" Style="{StaticResource SectionHeader}"
                           VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" Spacing="1">
                        <Label Text="{Binding DebtsTotalDisplay}" Style="{StaticResource RowMeta}"
                               TextColor="{StaticResource Negative}" />
                        <Label Text="{Binding DebtsInstallmentsDisplay}" Style="{StaticResource RowMeta}" />
                    </VerticalStackLayout>
                </Grid>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding DebtRows}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:DebtRowVm">
                            <SwipeView>
                                <SwipeView.RightItems>
                                    <SwipeItems>
                                        <SwipeItem Text="Edytuj" BackgroundColor="{StaticResource SurfaceRaised}"
                                                   Command="{Binding EditCommand}" />
                                        <SwipeItem Text="Usuń" BackgroundColor="{StaticResource NegativeDim}"
                                                   Command="{Binding DeleteCommand}" />
                                    </SwipeItems>
                                </SwipeView.RightItems>

                                <Border Style="{StaticResource Card}">
                                    <VerticalStackLayout Spacing="9">

                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                                <Label Text="{Binding Name}" Style="{StaticResource RowTitle}" />
                                                <Label Text="{Binding KindDisplay}" Style="{StaticResource Caption}" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                <Label Text="{Binding BalanceDisplay}" Style="{StaticResource NegativeValue}" />
                                                <Label Text="{Binding InstallmentDisplay}" Style="{StaticResource RowMeta}" />
                                            </VerticalStackLayout>
                                        </Grid>

                                        <!-- Pasek rośnie w stronę spłaty, więc zieleń jest tu nagrodą,
                                             a nie ostrzeżeniem — odwrotnie niż przy kopertach. -->
                                        <ProgressBar Progress="{Binding Progress}" HeightRequest="4"
                                                     ProgressColor="{StaticResource Positive}" />

                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <Label Grid.Column="0" Text="{Binding PaidOffDisplay}"
                                                   Style="{StaticResource Caption}" VerticalOptions="Center" />
                                            <Label Grid.Column="1" Text="{Binding PayoffDisplay}"
                                                   Style="{StaticResource InfoCaption}" VerticalOptions="Center" />
                                        </Grid>

                                        <Button Text="Zapłać ratę" Command="{Binding PayCommand}"
                                                IsVisible="{Binding IsNotPaidOff}"
                                                Style="{StaticResource RowAction}" HorizontalOptions="End" />

                                    </VerticalStackLayout>
                                </Border>
                            </SwipeView>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
