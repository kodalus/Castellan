<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Castellan.App.ViewModels"
             x:Class="Castellan.App.Views.UpdateAssetValuePage"
             x:DataType="vm:UpdateAssetValueViewModel"
             Title="Aktualizacja wartości">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Zapisz" Command="{Binding SaveCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource FormBody}">

            <Border Style="{StaticResource ErrorBanner}" IsVisible="{Binding HasError}">
                <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
            </Border>

            <VerticalStackLayout Spacing="3">
                <Label Text="{Binding AssetName}" Style="{StaticResource Title}" />
                <Label Text="{Binding CurrentValueDisplay}" Style="{StaticResource Secondary}" />
            </VerticalStackLayout>

            <VerticalStackLayout Style="{StaticResource Field}">
                <Label Text="Nowa wartość (zł)" Style="{StaticResource FieldLabel}" />
                <Entry Text="{Binding NewValueText}" Keyboard="Numeric" Placeholder="np. 52000"
                       FontSize="{StaticResource SizeTitle}"
                       ReturnCommand="{Binding SaveCommand}" />
            </VerticalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
