<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Castellan.App.ViewModels"
             x:Class="Castellan.App.Views.AssignCategoryPage"
             x:DataType="vm:AssignCategoryViewModel"
             Title="Przypisz kategorię">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Zapisz" Command="{Binding SaveCommand}" Priority="0" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource FormBody}">

            <!-- Sprzedawca i kwota to jedyne, po czym rozpoznaje się transakcję
                 z powiadomienia — dlatego stoją w karcie, nie w zwykłym wierszu. -->
            <Border Style="{StaticResource Card}" Margin="0">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <Label Grid.Column="0" Text="{Binding MerchantDisplay}"
                           Style="{StaticResource RowTitle}" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{Binding AmountDisplay}"
                           Style="{StaticResource RowValue}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <VerticalStackLayout Style="{StaticResource Field}">
                <Label Text="Kategoria" Style="{StaticResource FieldLabel}" />
                <Picker ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                        ItemDisplayBinding="{Binding Name}" Title="Wybierz kategorię…" />
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="{Binding HasMerchantKey}">
                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                    <Label Text="Zapamiętaj regułę" Style="{StaticResource RowTitle}" />
                    <Label Text="Kolejne transakcje od tego sprzedawcy dostaną tę kategorię same."
                           Style="{StaticResource Caption}" />
                </VerticalStackLayout>
                <Switch Grid.Column="1" IsToggled="{Binding RememberRule}" VerticalOptions="Center" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
