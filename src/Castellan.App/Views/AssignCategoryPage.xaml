<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Castellan.App.ViewModels"
             x:Class="Castellan.App.Views.AssignCategoryPage"
             x:DataType="vm:AssignCategoryViewModel"
             Title="Przypisz kategorię">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Zapisz" Command="{Binding SaveCommand}" Priority="0" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Spacing="0" Padding="16,12">

            <!-- Transaction summary card -->
            <Border Padding="16" Margin="0,0,0,16"
                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#444}"
                    StrokeShape="RoundRectangle 8">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4">
                    <Label Grid.Row="0" Grid.Column="0"
                           Text="{Binding MerchantDisplay}"
                           FontSize="16" FontAttributes="Bold" />
                    <Label Grid.Row="0" Grid.Column="1"
                           Text="{Binding AmountDisplay}"
                           FontSize="16" FontAttributes="Bold"
                           HorizontalOptions="End" />
                </Grid>
            </Border>

            <!-- Category picker -->
            <Label Text="Kategoria" FontSize="12" TextColor="Gray" Margin="0,0,0,4" />
            <Picker ItemsSource="{Binding Categories}"
                    SelectedItem="{Binding SelectedCategory}"
                    ItemDisplayBinding="{Binding Name}"
                    Title="Wybierz kategorię..."
                    Margin="0,0,0,16" />

            <!-- Remember rule toggle -->
            <Grid ColumnDefinitions="*,Auto"
                  IsVisible="{Binding HasMerchantKey}"
                  Margin="0,0,0,8">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="Zapamiętaj regułę" FontSize="14" />
                    <Label Text="Automatycznie przypisuj tę kategorię przy kolejnych transakcjach"
                           FontSize="11" TextColor="Gray" />
                </VerticalStackLayout>
                <Switch Grid.Column="1"
                        IsToggled="{Binding RememberRule}"
                        VerticalOptions="Center" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
