<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:Castellan.App.Resources.Strings"
             xmlns:vm="clr-namespace:Castellan.App.ViewModels"
             x:Class="Castellan.App.Views.MoveFundPage"
             x:DataType="vm:MoveFundViewModel"
             Title="Przenieś między funduszami">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{x:Static strings:AppResources.Button_Save}" Command="{Binding SaveCommand}" />
        <ToolbarItem Text="{x:Static strings:AppResources.Button_Cancel}" Command="{Binding CancelCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource FormBody}">

            <Border Style="{StaticResource ErrorBanner}" IsVisible="{Binding HasError}">
                <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
            </Border>

            <!-- Przełożenie między kopertami nie rusza żadnego konta, więc nie powstaje
                 ani jedna transakcja. Warto to powiedzieć wprost, bo obejście przez dwa
                 przelewy daje ten sam efekt na funduszach i cztery wpisy w historii. -->
            <Label Style="{StaticResource FieldHint}"
                   Text="Pieniądze nie ruszają się z konta — zmieniają się tylko salda dwóch funduszy. Żadna transakcja nie powstanie i budżet miesiąca zostaje bez zmian." />

            <VerticalStackLayout Style="{StaticResource Field}">
                <Label Text="Z funduszu" Style="{StaticResource FieldLabel}" />
                <Label Text="{Binding FromName}" Style="{StaticResource RowTitle}" />
                <Label Text="{Binding FromBalance}" Style="{StaticResource Caption}" />
            </VerticalStackLayout>

            <VerticalStackLayout Style="{StaticResource Field}">
                <Label Text="Na fundusz" Style="{StaticResource FieldLabel}" />
                <Picker ItemsSource="{Binding Targets}" ItemDisplayBinding="{Binding Display}"
                        SelectedItem="{Binding Target}" />
            </VerticalStackLayout>

            <VerticalStackLayout Style="{StaticResource Field}">
                <Label Text="Kwota" Style="{StaticResource FieldLabel}" />
                <Entry x:Name="AmountEntry" Text="{Binding AmountText}" Keyboard="Numeric" Placeholder="100,00" />
            </VerticalStackLayout>

            <HorizontalStackLayout Spacing="8" IsVisible="{OnPlatform Default=False, WinUI=True}">
                <Button Text="{x:Static strings:AppResources.Button_Save}" Command="{Binding SaveCommand}" />
                <Button Text="{x:Static strings:AppResources.Button_Cancel}" Command="{Binding CancelCommand}"
                        Style="{StaticResource GhostButton}" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
