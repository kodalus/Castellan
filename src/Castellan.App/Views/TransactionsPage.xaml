<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:Castellan.App.Resources.Strings"
             xmlns:vm="clr-namespace:Castellan.App.ViewModels"
             x:Class="Castellan.App.Views.TransactionsPage"
             x:DataType="vm:TransactionsViewModel"
             Title="{x:Static strings:AppResources.Tab_Transactions}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Przelew między kontami" Command="{Binding AddTransferCommand}" Order="Secondary" Priority="0" />
        <ToolbarItem Text="Reguły" Command="{Binding ManageRulesCommand}" Order="Secondary" Priority="1" />
        <ToolbarItem Text="Kategorie" Command="{Binding ManageCategoriesCommand}" Order="Secondary" Priority="2" />
        <ToolbarItem Text="⚡" Command="{Binding QuickAddCommand}" Priority="0" />
        <ToolbarItem Text="+" Command="{Binding AddTransactionCommand}" Priority="1" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*" RowSpacing="0">

        <!-- Ten sam pasek miesiąca co na Głównej — kontekst, nie liczba, więc cichy. -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="8,10,8,4">
            <Button Grid.Column="0" Text="‹" Style="{StaticResource StepperButton}"
                    Command="{Binding PreviousMonthCommand}" />
            <Label Grid.Column="1" Text="{Binding CurrentMonthDisplay}"
                   Style="{StaticResource SectionHeader}"
                   HorizontalTextAlignment="Center" VerticalOptions="Center" />
            <Button Grid.Column="2" Text="›" Style="{StaticResource StepperButton}"
                    Command="{Binding NextMonthCommand}" />
        </Grid>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Transactions}" Margin="16,0">
            <CollectionView.EmptyView>
                <Label Text="{x:Static strings:AppResources.Transactions_Empty}" Style="{StaticResource EmptyState}" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:TransactionRow">
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Z funduszu" BackgroundColor="{StaticResource InfoDim}"
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TransactionsViewModel}}, Path=PayFromFundCommand}"
                                           CommandParameter="{Binding .}" />
                                <SwipeItem Text="{x:Static strings:AppResources.Transactions_Delete}"
                                           BackgroundColor="{StaticResource NegativeDim}"
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TransactionsViewModel}}, Path=DeleteTransactionCommand}"
                                           CommandParameter="{Binding .}" />
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,11" ColumnSpacing="12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TransactionsViewModel}}, Path=EditTransactionCommand}"
                                    CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>

                            <Label Grid.Column="0" Text="{Binding DateDisplay}" Style="{StaticResource Caption}"
                                   VerticalOptions="Center" WidthRequest="46"
                                   HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />

                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding CategoryName}" Style="{StaticResource RowTitle}" />
                                <Label Text="{Binding Note}" Style="{StaticResource Caption}"
                                       IsVisible="{Binding Note, Converter={StaticResource IsNotEmpty}}" />
                                <Label Text="{Binding FundLabel}" Style="{StaticResource InfoCaption}"
                                       IsVisible="{Binding IsPaidFromFund}" />
                            </VerticalStackLayout>

                            <!-- Wpływ na zielono, wydatek neutralnie: w gęstej liście to jedyna
                                 rzecz, która pozwala odróżnić kierunek bez czytania znaku. -->
                            <Label Grid.Column="2" Text="{Binding AmountDisplay}" Style="{StaticResource RowValue}"
                                   VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsIncome}" Value="True">
                                        <Setter Property="TextColor" Value="{StaticResource Positive}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsExcluded}" Value="True">
                                        <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Grid>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
