<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:Castellan.App.Resources.Strings"
             xmlns:vm="clr-namespace:Castellan.App.ViewModels"
             x:Class="Castellan.App.Views.TransactionsPage"
             x:DataType="vm:TransactionsViewModel"
             Title="{x:Static strings:AppResources.Tab_Transactions}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Przelew między kontami" Command="{Binding AddTransferCommand}" Order="Secondary" Priority="0" />
        <ToolbarItem Text="Reguły" Command="{Binding ManageRulesCommand}" Order="Secondary" Priority="1" />
        <ToolbarItem Text="Kategorie" Command="{Binding ManageCategoriesCommand}" Order="Secondary" Priority="2" />
        <ToolbarItem Text="Sprawdź kwoty z powiadomień" Command="{Binding AuditAmountsCommand}" Order="Secondary" Priority="3" />
        <ToolbarItem Text="🔍" Command="{Binding ToggleSearchCommand}" Priority="0" />
        <ToolbarItem Text="⚡" Command="{Binding QuickAddCommand}" Priority="1" />
        <ToolbarItem Text="+" Command="{Binding AddTransactionCommand}" Priority="2" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="0">

        <!-- Lupka rozwija się nad listą, nie zasłania jej i nie zostawia po sobie
             śladu: zwinięcie kasuje tekst, bo lista z niewidocznym filtrem wygląda
             na kompletną, a nie jest. -->
        <VerticalStackLayout Grid.Row="0" IsVisible="{Binding IsSearching}" Margin="8,8,8,0" Spacing="2">
            <SearchBar Text="{Binding Query}" Placeholder="Szukaj: sklep, kategoria, kwota, data…" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="4,0,4,4">
                <Label Grid.Column="0" Text="{Binding ResultSummary}" Style="{StaticResource Caption}"
                       VerticalOptions="Center" />
                <HorizontalStackLayout Grid.Column="1" Spacing="8">
                    <Label Text="Cała historia" Style="{StaticResource Caption}" VerticalOptions="Center" />
                    <Switch IsToggled="{Binding SearchesEverything}" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Grid>
        </VerticalStackLayout>

        <!-- Ten sam pasek miesiąca co na Głównej — kontekst, nie liczba, więc cichy.
             Przy szukaniu w całej historii znika: twierdziłby, że pokazuje listopad,
             pokazując wyniki z sierpnia. -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="8,10,8,4"
              IsVisible="{Binding ShowsMonthBar}">
            <Button Grid.Column="0" Text="‹" Style="{StaticResource StepperButton}"
                    Command="{Binding PreviousMonthCommand}" />
            <Label Grid.Column="1" Text="{Binding CurrentMonthDisplay}"
                   Style="{StaticResource SectionHeader}"
                   HorizontalTextAlignment="Center" VerticalOptions="Center" />
            <Button Grid.Column="2" Text="›" Style="{StaticResource StepperButton}"
                    Command="{Binding NextMonthCommand}" />
        </Grid>

        <CollectionView Grid.Row="2" ItemsSource="{Binding Transactions}" Margin="16,0">
            <CollectionView.EmptyView>
                <VerticalStackLayout>
                    <Label Text="{x:Static strings:AppResources.Transactions_Empty}"
                           Style="{StaticResource EmptyState}" IsVisible="{Binding HasNoQuery}" />
                    <Label Text="Nic nie pasuje do szukanego tekstu. Spróbuj krótszego słowa albo włącz „Cała historia”."
                           Style="{StaticResource EmptyState}" IsVisible="{Binding HasQuery}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:TransactionRow">
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Z funduszu" BackgroundColor="{StaticResource InfoDim}"
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TransactionsViewModel}}, Path=PayFromFundCommand}"
                                           CommandParameter="{Binding .}" />
                                <SwipeItem Text="{x:Static strings:AppResources.Transactions_Delete}"
                                           BackgroundColor="{StaticResource NegativeDim}"
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TransactionsViewModel}}, Path=DeleteTransactionCommand}"
                                           CommandParameter="{Binding .}" />
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" Padding="0,11" ColumnSpacing="12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TransactionsViewModel}}, Path=EditTransactionCommand}"
                                    CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>

                            <Label Grid.Column="0" Text="{Binding DateDisplay}" Style="{StaticResource Caption}"
                                   VerticalOptions="Center" WidthRequest="46"
                                   HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />

                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding CategoryName}" Style="{StaticResource RowTitle}" />
                                <Label Text="{Binding Note}" Style="{StaticResource Caption}"
                                       IsVisible="{Binding Note, Converter={StaticResource IsNotEmpty}}" />
                                <Label Text="{Binding FundLabel}" Style="{StaticResource InfoCaption}"
                                       IsVisible="{Binding IsPaidFromFund}" />
                                <Label Text="{Binding ProposedLabel}" Style="{StaticResource BrassCaption}"
                                       IsVisible="{Binding IsProposedTransfer}" />
                            </VerticalStackLayout>

                            <!-- Wpływ na zielono, wydatek neutralnie: w gęstej liście to jedyna
                                 rzecz, która pozwala odróżnić kierunek bez czytania znaku. -->
                            <Label Grid.Column="2" Text="{Binding AmountDisplay}" Style="{StaticResource RowValue}"
                                   VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsIncome}" Value="True">
                                        <Setter Property="TextColor" Value="{StaticResource Positive}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsExcluded}" Value="True">
                                        <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>

                            <!-- Widoczne tylko na pulpicie: tam przeciągnięcia wiersza
                                 nikt nie odkryje, a obsługa idzie z klawiatury, więc
                                 działanie musi stać w kolejce Taba. Na telefonie zostaje
                                 przeciągnięcie, gdzie jest naturalne i nie zajmuje miejsca. -->
                            <Button Grid.Column="3" Text="⋮" Style="{StaticResource RowAction}"
                                    VerticalOptions="Center" Padding="10,4"
                                    IsVisible="{OnPlatform Default=False, WinUI=True}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TransactionsViewModel}}, Path=RowActionsCommand}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
