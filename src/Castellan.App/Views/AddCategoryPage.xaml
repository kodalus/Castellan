<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Castellan.App.ViewModels"
             x:Class="Castellan.App.Views.AddCategoryPage"
             x:DataType="vm:AddCategoryViewModel"
             Title="Nowa kategoria">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Zapisz" Command="{Binding SaveCommand}" />
        <ToolbarItem Text="Anuluj" Command="{Binding CancelCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource FormBody}">

            <VerticalStackLayout Style="{StaticResource Field}">
                <Label Text="Nazwa" Style="{StaticResource FieldLabel}" />
                <Entry Text="{Binding Name}" Placeholder="np. Kawiarnia, Paliwo, Wynagrodzenie"
                       ClearButtonVisibility="WhileEditing" />
            </VerticalStackLayout>

            <VerticalStackLayout Style="{StaticResource Field}">
                <Label Text="Rodzaj" Style="{StaticResource FieldLabel}" />
                <Picker ItemsSource="{Binding Kinds}" SelectedIndex="{Binding KindIndex}" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
