<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Castellan.App.ViewModels"
             x:Class="Castellan.App.Views.FundsPage"
             x:DataType="vm:FundsViewModel"
             Title="Fundusze">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="+" Command="{Binding AddFundCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="0,0,0,16">

            <!-- Pytanie o dzień wypłaty: bez niego raty liczą się kalendarzowo,
                 więc to nie ozdoba, tylko brakujące dane. -->
            <Border Style="{StaticResource WarningBanner}" IsVisible="{Binding NeedsPaydate}">
                <VerticalStackLayout Spacing="10">
                    <Label Style="{StaticResource WarningText}"
                           Text="Podaj dzień miesiąca, w którym dostajesz wypłatę — wtedy raty policzą się na wypłaty, a nie na kalendarz." />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Entry Grid.Column="0" Text="{Binding PaydateText}" Keyboard="Numeric"
                               Placeholder="np. 25" MaxLength="2" />
                        <!-- Pełny mosiądz, nie RowAction: RowAction ma tło BrassWash,
                             czyli dokładnie tło tego banera — przycisk by w nim zniknął. -->
                        <Button Grid.Column="1" Text="Zapisz" Command="{Binding SavePaydateCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Suma odpisów to liczba, którą przepisuje się do koperty „Rezerwy”,
                 więc stoi na górze jako jedyna duża na tym ekranie. -->
            <Border Style="{StaticResource Card}" IsVisible="{Binding IsNotEmpty}" Margin="12,10,12,4">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{Binding TotalSuggestedDisplay}" Style="{StaticResource SubHero}" />
                    <Label Text="{Binding TotalBalanceDisplay}" Style="{StaticResource Secondary}" />
                    <Label Text="Tę kwotę zaplanuj w kopercie „Rezerwy”." Style="{StaticResource Caption}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Brak funduszy. Dodaj pierwszy tapując +." Style="{StaticResource EmptyState}"
                   IsVisible="{Binding IsEmpty}" />

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}" IsVisible="{Binding IsNotEmpty}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:FundRow">
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="Edytuj" BackgroundColor="{StaticResource SurfaceRaised}"
                                               Command="{Binding EditCommand}" />
                                    <SwipeItem Text="Usuń" BackgroundColor="{StaticResource NegativeDim}"
                                               Command="{Binding DeleteCommand}" />
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <Border Style="{StaticResource Card}">
                                <VerticalStackLayout Spacing="9">

                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Name}" Style="{StaticResource RowTitle}" />
                                            <Label Text="{Binding KindDisplay}" Style="{StaticResource Caption}" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding BalanceDisplay}" Style="{StaticResource RowValue}" />
                                            <Label Text="{Binding TargetDisplay}" Style="{StaticResource RowMeta}" />
                                        </VerticalStackLayout>
                                    </Grid>

                                    <ProgressBar Progress="{Binding Progress}" HeightRequest="4"
                                                 ProgressColor="{StaticResource Info}" />

                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <Label Grid.Column="0" Text="{Binding PeriodsRemainingDisplay}"
                                               Style="{StaticResource Caption}" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="{Binding DeficitDisplay}"
                                               Style="{StaticResource NegativeCaption}"
                                               IsVisible="{Binding IsDelayed}" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="{Binding DeficitDisplay}"
                                               Style="{StaticResource PositiveCaption}"
                                               IsVisible="{Binding IsNotDelayed}" VerticalOptions="Center" />
                                    </Grid>

                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <Label Grid.Column="0" Text="{Binding SuggestedMonthlyDisplay}"
                                               Style="{StaticResource Secondary}" VerticalOptions="Center" />
                                        <Button Grid.Column="1" Text="Wpłać" Command="{Binding ContributeCommand}"
                                                Style="{StaticResource RowAction}" />
                                    </Grid>

                                </VerticalStackLayout>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
