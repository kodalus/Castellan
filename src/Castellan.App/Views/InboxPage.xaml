<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Castellan.App.ViewModels"
             x:Class="Castellan.App.Views.InboxPage"
             x:DataType="vm:InboxViewModel"
             Title="Skrzynka odbiorcza">

    <Grid RowDefinitions="Auto,*">

        <!-- Permission denied banner -->
        <Border Grid.Row="0"
                IsVisible="{Binding IsPermissionDenied}"
                BackgroundColor="#FFF9C4"
                Padding="12,10" Margin="12,8,12,0">
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0"
                       Text="Brak uprawnień do powiadomień. Aplikacja nie może odbierać transakcji automatycznie."
                       FontSize="12" TextColor="#5D4037" />
                <Button Grid.Column="1"
                        Text="Ustawienia"
                        Command="{Binding OpenPermissionSettingsCommand}"
                        FontSize="11" Padding="8,4"
                        BackgroundColor="#F57F17" TextColor="White"
                        CornerRadius="4" />
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout>

                <!-- ===== Transfer proposals section ===== -->
                <VerticalStackLayout IsVisible="{Binding HasProposals}">

                    <Label Text="Proponowane przelewy"
                           FontSize="12" FontAttributes="Bold" TextColor="Gray"
                           Margin="16,12,16,4" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Proposals}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:TransferProposalRow">
                                <Border Margin="12,4" Padding="14,12"
                                        Stroke="{AppThemeBinding Light=#B3E5FC, Dark=#0277BD}"
                                        StrokeShape="RoundRectangle 8"
                                        BackgroundColor="{AppThemeBinding Light=#E1F5FE, Dark=#01579B22}">
                                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">

                                        <!-- Header row: accounts + amount -->
                                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0"
                                                   FontSize="13" FontAttributes="Bold">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding FromAccount}" />
                                                        <Span Text=" → " TextColor="Gray" />
                                                        <Span Text="{Binding ToAccount}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <Label Grid.Column="1"
                                                   Text="{Binding AmountDisplay}"
                                                   FontSize="13" FontAttributes="Bold"
                                                   HorizontalOptions="End" />
                                        </Grid>

                                        <!-- Date -->
                                        <Label Grid.Row="1"
                                               Text="{Binding DateDisplay}"
                                               FontSize="11" TextColor="Gray" />

                                        <!-- Action buttons -->
                                        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="8">
                                            <Button Grid.Column="0"
                                                    Text="Tak, to przelew"
                                                    Command="{Binding ConfirmCommand}"
                                                    BackgroundColor="#0277BD" TextColor="White"
                                                    FontSize="12" CornerRadius="6" Padding="0,8" />
                                            <Button Grid.Column="1"
                                                    Text="Nie"
                                                    Command="{Binding RejectCommand}"
                                                    BackgroundColor="{AppThemeBinding Light=#EEEEEE, Dark=#444}"
                                                    TextColor="{AppThemeBinding Light=#333, Dark=#EEE}"
                                                    FontSize="12" CornerRadius="6" Padding="0,8" />
                                        </Grid>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1"
                             Color="{AppThemeBinding Light=#E0E0E0, Dark=#444}"
                             Margin="16,8" />
                </VerticalStackLayout>

                <!-- ===== Unsorted transactions section ===== -->
                <Label Text="Do skategoryzowania — dotknij wiersza"
                       FontSize="12" TextColor="Gray"
                       Margin="16,8,16,2"
                       IsVisible="{Binding IsNotEmpty}" />

                <Label Text="Brak nieskatgoryzowanych transakcji"
                       HorizontalOptions="Center" TextColor="Gray" FontSize="14"
                       Margin="0,40"
                       IsVisible="{Binding IsEmpty}" />

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:UnsortedTxRow">
                            <Grid Padding="16,12" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto"
                                  RowSpacing="2">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding NavigateCommand}" />
                                </Grid.GestureRecognizers>
                                <Label Grid.Row="0" Grid.Column="0"
                                       Text="{Binding MerchantDisplay}"
                                       FontSize="14" FontAttributes="Bold"
                                       LineBreakMode="TailTruncation" />
                                <Label Grid.Row="0" Grid.Column="1"
                                       Text="{Binding AmountDisplay}"
                                       FontSize="14" FontAttributes="Bold"
                                       HorizontalOptions="End" Margin="8,0,0,0" />
                                <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                       Text="{Binding DateDisplay}"
                                       FontSize="11" TextColor="Gray" />
                                <BoxView Grid.Row="2" Grid.ColumnSpan="2"
                                         HeightRequest="1"
                                         Color="{AppThemeBinding Light=#F0F0F0, Dark=#333}"
                                         Margin="-16,6,-16,0" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
