<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Castellan.App.ViewModels"
             x:Class="Castellan.App.Views.InboxPage"
             x:DataType="vm:InboxViewModel"
             Title="Skrzynka">

    <Grid RowDefinitions="Auto,*" RowSpacing="0">

        <Border Grid.Row="0" Style="{StaticResource WarningBanner}"
                IsVisible="{Binding IsPermissionDenied}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Label Grid.Column="0" Style="{StaticResource WarningText}" VerticalOptions="Center"
                       Text="Brak uprawnień do powiadomień — transakcje nie będą się łapać automatycznie." />
                <!-- Pełny mosiądz, nie RowAction: RowAction ma tło BrassWash,
                     czyli dokładnie tło tego banera — przycisk by w nim zniknął. -->
                <Button Grid.Column="1" Text="Ustawienia"
                        Command="{Binding OpenPermissionSettingsCommand}" />
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="0,0,0,16">

                <!-- Wybór trybu pracy stoi na górze Skrzynki, bo to jedyny ekran,
                     którego zawartość od niego zależy: w trybie ręcznym nic tu
                     samo nie trafia. -->
                <Border Style="{StaticResource Card}" Margin="12,10,12,4">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Skąd biorą się transakcje" Style="{StaticResource SectionHeader}" />

                        <VerticalStackLayout Spacing="2">
                            <RadioButton Content="Z powiadomień bankowych" GroupName="captureMode"
                                         IsChecked="{Binding UsesNotifications, Mode=TwoWay}" />
                            <Label Style="{StaticResource Caption}" Margin="36,0,0,0"
                                   Text="Aplikacja czyta powiadomienia z ING, Revolut i Portfela Google, i sama zakłada transakcje." />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="2">
                            <RadioButton Content="Wpisuję wszystko ręcznie" GroupName="captureMode"
                                         IsChecked="{Binding UsesManualEntry, Mode=TwoWay}" />
                            <Label Style="{StaticResource Caption}" Margin="36,0,0,0"
                                   Text="Powiadomienia są ignorowane, nawet gdy uprawnienie jest przyznane — inaczej ten sam wydatek trafiłby do aplikacji dwa razy. Aplikacja przestaje też upominać się o dostęp." />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- ===== Propozycje przelewów ===== -->
                <VerticalStackLayout IsVisible="{Binding HasProposals}">

                    <Label Text="Proponowane przelewy" Style="{StaticResource SectionHeader}"
                           Margin="16,14,16,4" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Proposals}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:TransferProposalRow">
                                <!-- Stal, nie mosiądz: to pytanie do rozstrzygnięcia,
                                     a nie ostrzeżenie ani akcja główna. -->
                                <Border Style="{StaticResource CardRow}"
                                        BackgroundColor="{StaticResource InfoWash}"
                                        Stroke="{StaticResource Hairline}">
                                    <VerticalStackLayout Spacing="10">

                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <Label Grid.Column="0" Style="{StaticResource RowTitle}" VerticalOptions="Center">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding FromAccount}" />
                                                        <Span Text="  →  " />
                                                        <Span Text="{Binding ToAccount}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <Label Grid.Column="1" Text="{Binding AmountDisplay}"
                                                   Style="{StaticResource RowValue}" VerticalOptions="Center" />
                                        </Grid>

                                        <Label Text="{Binding DateDisplay}" Style="{StaticResource Caption}" />

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                            <Button Grid.Column="0" Text="Tak, to przelew"
                                                    Command="{Binding ConfirmCommand}"
                                                    Style="{StaticResource RowAction}" />
                                            <Button Grid.Column="1" Text="Nie"
                                                    Command="{Binding RejectCommand}"
                                                    Style="{StaticResource GhostButton}" />
                                        </Grid>

                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- ===== Do skategoryzowania ===== -->
                <Label Text="Do skategoryzowania" Style="{StaticResource SectionHeader}"
                       Margin="16,14,16,2" IsVisible="{Binding IsNotEmpty}" />
                <Label Text="Dotknij wiersza, by przypisać kategorię." Style="{StaticResource Caption}"
                       Margin="16,0,16,4" IsVisible="{Binding IsNotEmpty}" />

                <Label Text="{Binding EmptyStateText}" Style="{StaticResource EmptyState}"
                       IsVisible="{Binding IsEmpty}" />

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}" Margin="16,0">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:UnsortedTxRow">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto"
                                  ColumnSpacing="10" RowSpacing="2" Padding="0,11">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding NavigateCommand}" />
                                </Grid.GestureRecognizers>
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding MerchantDisplay}"
                                       Style="{StaticResource RowTitle}" />
                                <Label Grid.Row="0" Grid.Column="1" Text="{Binding AmountDisplay}"
                                       Style="{StaticResource RowValue}" />
                                <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                       Text="{Binding DateDisplay}" Style="{StaticResource Caption}" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
