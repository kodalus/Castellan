<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Castellan.App.ViewModels"
             x:Class="Castellan.App.Views.AddAssetPage"
             x:DataType="vm:AddAssetViewModel"
             Title="Nowe aktywo">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Zapisz" Command="{Binding SaveCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource FormBody}">

            <Border Style="{StaticResource ErrorBanner}" IsVisible="{Binding HasError}">
                <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
            </Border>

            <VerticalStackLayout Style="{StaticResource Field}">
                <Label Text="Nazwa" Style="{StaticResource FieldLabel}" />
                <Entry Text="{Binding Name}" Placeholder="np. Konto oszczędnościowe PKO" MaxLength="100" />
            </VerticalStackLayout>

            <VerticalStackLayout Style="{StaticResource Field}">
                <Label Text="Poziom płynności" Style="{StaticResource FieldLabel}" />
                <Picker ItemsSource="{Binding Liquidities}" SelectedItem="{Binding SelectedLiquidity}"
                        ItemDisplayBinding="{Binding Display}" />
                <Label Text="Jak szybko dasz radę zamienić to na gotówkę — poduszka liczy się warstwami."
                       Style="{StaticResource FieldHint}" />
            </VerticalStackLayout>

            <VerticalStackLayout Style="{StaticResource Field}">
                <Label Text="Aktualna wartość (zł)" Style="{StaticResource FieldLabel}" />
                <Entry Text="{Binding ValueText}" Keyboard="Numeric" Placeholder="np. 50000" />
            </VerticalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
