<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Castellan.App"
             xmlns:conv="clr-namespace:Castellan.App.Converters"
             x:Class="Castellan.App.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:SpentFractionToColorConverter x:Key="SpentFractionToColor" />
            <conv:StringNotEmptyConverter x:Key="IsNotEmpty" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
