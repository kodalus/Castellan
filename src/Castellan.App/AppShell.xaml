<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Castellan.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Castellan.App.Views">

    <TabBar>
        <ShellContent Title="Главная"  Route="dashboard"    ContentTemplate="{DataTemplate views:DashboardPage}" />
        <ShellContent Title="Счета"    Route="accounts"     ContentTemplate="{DataTemplate views:AccountsPage}" />
        <ShellContent Title="Операции" Route="transactions" ContentTemplate="{DataTemplate views:TransactionsPage}" />
        <ShellContent Title="Конверты" Route="envelopes"    ContentTemplate="{DataTemplate views:EnvelopesPage}" />
    </TabBar>

</Shell>
