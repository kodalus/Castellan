<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Castellan.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Castellan.App.Views"
    xmlns:strings="clr-namespace:Castellan.App.Resources.Strings">

    <TabBar>
        <ShellContent Title="{x:Static strings:AppResources.Tab_Dashboard}"    Route="dashboard"    ContentTemplate="{DataTemplate views:DashboardPage}" />
        <ShellContent Title="{x:Static strings:AppResources.Tab_Accounts}"     Route="accounts"     ContentTemplate="{DataTemplate views:AccountsPage}" />
        <ShellContent Title="{x:Static strings:AppResources.Tab_Transactions}" Route="transactions" ContentTemplate="{DataTemplate views:TransactionsPage}" />
        <ShellContent Title="{x:Static strings:AppResources.Tab_Envelopes}"    Route="envelopes"    ContentTemplate="{DataTemplate views:EnvelopesPage}" />
        <ShellContent Title="{x:Static strings:AppResources.Tab_Inbox}"       Route="inbox"        ContentTemplate="{DataTemplate views:InboxPage}" />
        <ShellContent Title="Fundusze"                                         Route="funds"        ContentTemplate="{DataTemplate views:FundsPage}" />
        <ShellContent Title="Aktywa"                                           Route="assets"       ContentTemplate="{DataTemplate views:AssetsPage}" />
        <ShellContent Title="Kopia"                                            Route="backup"       ContentTemplate="{DataTemplate views:BackupPage}" />
    </TabBar>

</Shell>
