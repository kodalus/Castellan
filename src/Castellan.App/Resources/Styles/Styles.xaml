<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
        Skala rozmiarów. Wcześniej w ekranach było 14 różnych wartości bez systemu
        (ta sama rola miała raz 14, raz 15, raz 16). Tu jest ich sześć i każda ma
        jedno zastosowanie — dzięki temu wzrok od razu wie, co jest ważniejsze.
    -->
    <x:Double x:Key="SizeHero">32</x:Double>
    <x:Double x:Key="SizeSubHero">24</x:Double>
    <x:Double x:Key="SizeTitle">20</x:Double>
    <x:Double x:Key="SizeValue">15</x:Double>
    <x:Double x:Key="SizeBody">14</x:Double>
    <x:Double x:Key="SizeSecondary">12.5</x:Double>
    <x:Double x:Key="SizeCaption">11</x:Double>

    <!-- ===================== Kontrolki systemowe ===================== -->

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{StaticResource Ground}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{StaticResource Ground}" />
        <Setter Property="Shell.ForegroundColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="Shell.TitleColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="Shell.DisabledColor" Value="{StaticResource TextMuted}" />
        <Setter Property="Shell.UnselectedColor" Value="{StaticResource TextMuted}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{StaticResource Surface}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{StaticResource Brass}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{StaticResource Brass}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{StaticResource TextMuted}" />
    </Style>

    <Style TargetType="NavigationPage">
        <Setter Property="BarBackgroundColor" Value="{StaticResource Ground}" />
        <Setter Property="BarTextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="IconColor" Value="{StaticResource TextPrimary}" />
    </Style>

    <Style TargetType="TabbedPage">
        <Setter Property="BarBackgroundColor" Value="{StaticResource Surface}" />
        <Setter Property="SelectedTabColor" Value="{StaticResource Brass}" />
        <Setter Property="UnselectedTabColor" Value="{StaticResource TextMuted}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="{StaticResource SizeBody}" />
        <Setter Property="LineHeight" Value="1.25" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="TextColor" Value="{StaticResource TextOnAccent}" />
        <Setter Property="BackgroundColor" Value="{StaticResource Brass}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="{StaticResource SizeBody}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16,11" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource SurfaceRaised}" />
                            <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource BrassDim}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
        <Setter Property="Stroke" Value="{StaticResource HairlineBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="12" />
        </Setter>
    </Style>

    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource TextMuted}" />
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceRaised}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="{StaticResource SizeValue}" />
        <Setter Property="MinimumHeightRequest" Value="46" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource TextMuted}" />
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceRaised}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="{StaticResource SizeValue}" />
        <Setter Property="MinimumHeightRequest" Value="46" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="TitleColor" Value="{StaticResource TextMuted}" />
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceRaised}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="{StaticResource SizeValue}" />
        <Setter Property="MinimumHeightRequest" Value="46" />
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceRaised}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="{StaticResource SizeValue}" />
        <Setter Property="MinimumHeightRequest" Value="46" />
    </Style>

    <Style TargetType="TimePicker">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceRaised}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="{StaticResource SizeValue}" />
    </Style>

    <Style TargetType="SearchBar">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource TextMuted}" />
        <Setter Property="CancelButtonColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceRaised}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Color" Value="{StaticResource Brass}" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{StaticResource Brass}" />
        <Setter Property="ThumbColor" Value="{StaticResource TextPrimary}" />
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <Style TargetType="Slider">
        <Setter Property="MinimumTrackColor" Value="{StaticResource Brass}" />
        <Setter Property="MaximumTrackColor" Value="{StaticResource Hairline}" />
        <Setter Property="ThumbColor" Value="{StaticResource Brass}" />
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="ProgressColor" Value="{StaticResource Brass}" />
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceRaised}" />
        <Setter Property="HeightRequest" Value="5" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{StaticResource Brass}" />
    </Style>

    <Style TargetType="IndicatorView">
        <Setter Property="IndicatorColor" Value="{StaticResource Hairline}" />
        <Setter Property="SelectedIndicatorColor" Value="{StaticResource Brass}" />
    </Style>

    <Style TargetType="RefreshView">
        <Setter Property="RefreshColor" Value="{StaticResource Brass}" />
    </Style>

    <Style TargetType="BoxView">
        <Setter Property="Color" Value="{StaticResource Hairline}" />
    </Style>

    <Style TargetType="SwipeItem">
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceRaised}" />
    </Style>

    <!-- ===================== Tekst ===================== -->

    <!-- Wielka liczba, po którą wzrok sięga pierwszy — jedna na ekran. -->
    <Style x:Key="Hero" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="{StaticResource SizeHero}" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="LineHeight" Value="1.1" />
    </Style>

    <!-- Druga co do ważności liczba na ekranie — np. wartość netto pod poduszką. -->
    <Style x:Key="SubHero" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="{StaticResource SizeSubHero}" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="LineHeight" Value="1.1" />
    </Style>

    <Style x:Key="Title" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="{StaticResource SizeTitle}" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
    </Style>

    <!--
        Nagłówek sekcji: mały, wyciszony, rozstrzelony. Ma dzielić ekran na części,
        a nie konkurować o uwagę z liczbami pod spodem.
    -->
    <Style x:Key="SectionHeader" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="{StaticResource SizeCaption}" />
        <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
        <Setter Property="CharacterSpacing" Value="1.2" />
        <Setter Property="TextTransform" Value="Uppercase" />
    </Style>

    <Style x:Key="RowTitle" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource SizeBody}" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>

    <!-- Kwoty w kolumnie muszą się równać cyfra pod cyfrą, stąd półgruby krój. -->
    <Style x:Key="RowValue" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="{StaticResource SizeValue}" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="HorizontalTextAlignment" Value="End" />
    </Style>

    <Style x:Key="Secondary" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource SizeSecondary}" />
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
    </Style>

    <Style x:Key="Caption" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource SizeCaption}" />
        <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
    </Style>

    <Style x:Key="CaptionEnd" TargetType="Label" BasedOn="{StaticResource Caption}">
        <Setter Property="HorizontalTextAlignment" Value="End" />
    </Style>

    <Style x:Key="PositiveValue" TargetType="Label" BasedOn="{StaticResource RowValue}">
        <Setter Property="TextColor" Value="{StaticResource Positive}" />
    </Style>

    <Style x:Key="NegativeValue" TargetType="Label" BasedOn="{StaticResource RowValue}">
        <Setter Property="TextColor" Value="{StaticResource Negative}" />
    </Style>

    <Style x:Key="PositiveCaption" TargetType="Label" BasedOn="{StaticResource Caption}">
        <Setter Property="TextColor" Value="{StaticResource Positive}" />
    </Style>

    <Style x:Key="NegativeCaption" TargetType="Label" BasedOn="{StaticResource Caption}">
        <Setter Property="TextColor" Value="{StaticResource Negative}" />
    </Style>

    <Style x:Key="InfoValue" TargetType="Label" BasedOn="{StaticResource RowValue}">
        <Setter Property="TextColor" Value="{StaticResource Info}" />
    </Style>

    <Style x:Key="InfoCaption" TargetType="Label" BasedOn="{StaticResource Caption}">
        <Setter Property="TextColor" Value="{StaticResource Info}" />
    </Style>

    <Style x:Key="BrassCaption" TargetType="Label" BasedOn="{StaticResource Caption}">
        <Setter Property="TextColor" Value="{StaticResource Brass}" />
    </Style>

    <!--
        Podpis pod kwotą w wierszu listy: jeszcze ciszej niż Caption, bo w gęstej
        liście dat i „zaktualizowano” te napisy powtarzają się w każdym wierszu.
    -->
    <Style x:Key="RowMeta" TargetType="Label" BasedOn="{StaticResource Caption}">
        <Setter Property="HorizontalTextAlignment" Value="End" />
        <Setter Property="LineHeight" Value="1.1" />
    </Style>

    <Style x:Key="EmptyState" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource SizeSecondary}" />
        <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="Margin" Value="32,48" />
    </Style>

    <!-- ===================== Formularze ===================== -->

    <!--
        Wszystkie formularze mają ten sam rytm: jeden odstęp między polami, jeden
        wewnątrz pola. Wcześniej każdy ekran miał własne wartości, przez co przejście
        z „Nowy fundusz” na „Nowe zobowiązanie” wyglądało jak zmiana aplikacji.
    -->
    <Style x:Key="FormBody" TargetType="VerticalStackLayout">
        <Setter Property="Padding" Value="16,16,16,32" />
        <Setter Property="Spacing" Value="18" />
    </Style>

    <Style x:Key="Field" TargetType="VerticalStackLayout">
        <Setter Property="Spacing" Value="6" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource SizeSecondary}" />
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
    </Style>

    <Style x:Key="FieldHint" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource SizeCaption}" />
        <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
    </Style>

    <!-- ===================== Karty i pojemniki ===================== -->

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
        <Setter Property="Stroke" Value="{StaticResource HairlineBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="Margin" Value="12,6" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="12" />
        </Setter>
    </Style>

    <Style x:Key="CardRow" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Margin" Value="12,4" />
    </Style>

    <!-- Kafelek liczby: bez obramowania, samo tło — trzy obok siebie nie mogą krzyczeć. -->
    <Style x:Key="StatTile" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
        <Setter Property="Stroke" Value="{StaticResource TransparentBrush}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="10" />
        </Setter>
    </Style>

    <!-- ===================== Paski komunikatów ===================== -->

    <!--
        Pasek ostrzeżenia/błędu ma kolorową krawędź z jednej strony zamiast całego
        jaskrawego tła: w ciemnym motywie duża jasna plama wypala oczy i wygląda
        jak dziura w ekranie.
    -->
    <Style x:Key="WarningBanner" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource BrassWash}" />
        <Setter Property="Stroke" Value="{StaticResource BrassBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="12,8,12,0" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="10" />
        </Setter>
    </Style>

    <Style x:Key="WarningText" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource SizeSecondary}" />
        <Setter Property="TextColor" Value="{StaticResource Brass}" />
    </Style>

    <Style x:Key="ErrorBanner" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource NegativeWash}" />
        <Setter Property="Stroke" Value="{StaticResource NegativeBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="10" />
        </Setter>
    </Style>

    <Style x:Key="ErrorText" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource SizeSecondary}" />
        <Setter Property="TextColor" Value="{StaticResource Negative}" />
    </Style>

    <!-- ===================== Przyciski ===================== -->

    <!-- Drugorzędny: ta sama waga wizualna co karta, więc nie rywalizuje z akcją główną. -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceRaised}" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="{StaticResource SizeSecondary}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,9" />
    </Style>

    <Style x:Key="DangerButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource NegativeWash}" />
        <Setter Property="TextColor" Value="{StaticResource Negative}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="{StaticResource SizeSecondary}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,9" />
    </Style>

    <!-- Strzałki miesiąca: mają być dotykalne, ale niewidoczne dopóki ich nie szukasz. -->
    <Style x:Key="StepperButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="FontSize" Value="{StaticResource SizeTitle}" />
        <Setter Property="WidthRequest" Value="48" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <!--
        Akcja wewnątrz wiersza listy („Wpłać”, „Zapłać ratę”). Wyciszona do poziomu
        karty, bo w liście dziesięciu wierszy dziesięć mosiężnych przycisków
        przykryłoby liczby, po które ta lista w ogóle istnieje.
    -->
    <Style x:Key="RowAction" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource BrassWash}" />
        <Setter Property="TextColor" Value="{StaticResource Brass}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="{StaticResource SizeSecondary}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="MinimumHeightRequest" Value="40" />
    </Style>

    <Style x:Key="Divider" TargetType="BoxView">
        <Setter Property="Color" Value="{StaticResource Hairline}" />
        <Setter Property="HeightRequest" Value="1" />
    </Style>


</ResourceDictionary>
