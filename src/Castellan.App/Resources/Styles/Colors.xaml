<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
        Paleta wyłącznie ciemna — aplikacja wymusza tryb ciemny w App.xaml.cs,
        więc nie ma wariantów jasnych i nie trzeba nigdzie pisać AppThemeBinding.

        Kamienne tło (lekko chłodne, nie czysta czerń — czerń przy dużym kontraście
        męczy oczy i rozmywa cienkie napisy) plus cztery akcenty, z których każdy
        coś znaczy. Kolor nigdy nie jest dekoracją: jeśli coś świeci na koralowo,
        znaczy że przekroczone albo że to dług.
    -->

    <!-- Powierzchnie -->
    <Color x:Key="Ground">#0F1216</Color>
    <Color x:Key="Surface">#171B21</Color>
    <Color x:Key="SurfaceRaised">#20252C</Color>
    <Color x:Key="Hairline">#2B323B</Color>
    <Color x:Key="HairlineStrong">#3A424D</Color>

    <!-- Tekst -->
    <Color x:Key="TextPrimary">#E9ECEF</Color>
    <Color x:Key="TextSecondary">#98A1AC</Color>
    <Color x:Key="TextMuted">#6A737E</Color>
    <Color x:Key="TextOnAccent">#17130A</Color>

    <!-- Mosiądz: akcja, zaznaczenie, bieżący stan -->
    <Color x:Key="Brass">#D9A441</Color>
    <Color x:Key="BrassDim">#8A6A2A</Color>
    <Color x:Key="BrassWash">#2A2214</Color>

    <!-- Zieleń: przychód, na bieżąco, spłacone -->
    <Color x:Key="Positive">#5FBF8B</Color>
    <Color x:Key="PositiveDim">#31694C</Color>
    <Color x:Key="PositiveWash">#14251C</Color>

    <!-- Koral: przekroczone, zaległe, dług -->
    <Color x:Key="Negative">#E07A6B</Color>
    <Color x:Key="NegativeDim">#7A3B32</Color>
    <Color x:Key="NegativeWash">#2A1A17</Color>

    <!-- Stal: fundusze, majątek, informacja neutralna -->
    <Color x:Key="Info">#6E93C4</Color>
    <Color x:Key="InfoDim">#3B5375</Color>
    <Color x:Key="InfoWash">#161E29</Color>

    <SolidColorBrush x:Key="GroundBrush" Color="{StaticResource Ground}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}" />
    <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource Hairline}" />
    <SolidColorBrush x:Key="BrassBrush" Color="{StaticResource Brass}" />
    <SolidColorBrush x:Key="NegativeBrush" Color="{StaticResource Negative}" />
    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />

    <!--
        Klucze z szablonu MAUI — kilka kontrolek i stylów systemowych odwołuje się
        do nich po nazwie, więc muszą istnieć. Przemapowane na paletę ciemną, żeby
        nic nie wracało do fioletu z szablonu.
    -->
    <Color x:Key="Primary">#D9A441</Color>
    <Color x:Key="PrimaryDark">#D9A441</Color>
    <Color x:Key="PrimaryDarkText">#17130A</Color>
    <Color x:Key="Secondary">#20252C</Color>
    <Color x:Key="SecondaryDarkText">#98A1AC</Color>
    <Color x:Key="Tertiary">#6E93C4</Color>

    <Color x:Key="White">#E9ECEF</Color>
    <Color x:Key="Black">#0F1216</Color>
    <Color x:Key="Magenta">#E07A6B</Color>
    <Color x:Key="MidnightBlue">#0F1216</Color>
    <Color x:Key="OffBlack">#171B21</Color>

    <Color x:Key="Gray100">#E9ECEF</Color>
    <Color x:Key="Gray200">#98A1AC</Color>
    <Color x:Key="Gray300">#6A737E</Color>
    <Color x:Key="Gray400">#5A626C</Color>
    <Color x:Key="Gray500">#3A424D</Color>
    <Color x:Key="Gray600">#2B323B</Color>
    <Color x:Key="Gray900">#171B21</Color>
    <Color x:Key="Gray950">#0F1216</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
